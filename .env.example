# Build-time public variable. Safe to expose — it is a Turnstile *site* key.
# `1x00000000000000000000AA` is Cloudflare's always-passes test key.
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Optional PostHog analytics (production builds only). The project token is
# public by design. Leave the token empty to turn analytics off.
PUBLIC_POSTHOG_PROJECT_TOKEN=""
# The managed reverse proxy (see README); https://us.i.posthog.com also works.
PUBLIC_POSTHOG_HOST="https://e.amansriven.com"
