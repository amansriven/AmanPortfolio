{
  "name": "amansriven-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && node -e \"require('fs').existsSync('.dev.vars')&&require('fs').copyFileSync('.dev.vars','dist/server/.dev.vars')\" && wrangler dev -c dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "check": "astro check",
    "format": "prettier --write \"**/*.{astro,svelte,ts,js,mjs,json,css,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{astro,svelte,ts,js,mjs,json,css,md,mdx}\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.2.4",
    "svelte": "^5.56.10",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
