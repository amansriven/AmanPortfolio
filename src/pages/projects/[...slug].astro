---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import { projectLinks, statusTone } from '../../lib/links';
import { projectTransition } from '../../lib/transitions';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  const ordered = projects.sort((a, b) => a.data.order - b.data.order);

  return ordered.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: ordered[(i + 1) % ordered.length]!,
    },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const displayUrl = data.liveUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');
const links = projectLinks(data);
/* Host only: an App Store path is too long to sit inside a button. */
const liveHost = data.liveUrl ? new URL(data.liveUrl).hostname : undefined;
const sections = headings.filter((heading) => heading.depth === 2);
const transition = projectTransition(project.id);
---

<BaseLayout
  title={data.seo?.title ?? data.title}
  description={data.seo?.description ?? data.summary}
  ogImage={`/og/${project.id}.png`}
  type="article"
>
  <article class="case" style={`--atmosphere: ${data.accent}`}>
    <div class="case__glow" aria-hidden="true"></div>

    <header class="case__hero shell shell--wide">
      <div class="case__intro">
        <a class="case__back" href="/projects">
          <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
            <path
              d="M12 7H2M2 7l4-4M2 7l4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>All projects</span>
        </a>

        <p class="case__top">
          <span class="eyebrow case__eyebrow">Project</span>
          <span class="case__status" data-tone={statusTone(data.status)}>{data.status}</span>
          <span class="case__year mono">{data.year}</span>
        </p>
        <h1 class="case__title" style={transition.title}>{data.title}</h1>
        <p class="case__tagline">{data.tagline}</p>

        {
          links.length > 0 && (
            <div class="case__links">
              {links.map((link) => (
                <a
                  class={link.kind === 'live' ? 'button-primary' : 'case__link-secondary'}
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                >
                  {link.kind === 'source' && (
                    <span class="case__gh" aria-hidden="true">
                      <SocialIcon label="GitHub" />
                    </span>
                  )}
                  <span>{link.label}</span>
                  {link.kind === 'live' && <span class="case__link-host mono">{liveHost}</span>}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }

        {data.sourceNote && <p class="case__source-note">{data.sourceNote}</p>}
      </div>

      <div class="case__visual" style={transition.media}>
        <Figure
          src={data.heroImage}
          alt={data.heroAlt}
          frame={data.heroFrame}
          url={data.heroFrame === 'browser' ? displayUrl : undefined}
          ratio={data.heroRatio}
          fit={data.heroFit}
          priority
        />
      </div>
    </header>

    {
      data.metrics.length > 0 && (
        <div class="shell shell--wide">
          <ul class="case__metrics">
            {data.metrics.map((metric) => (
              <li>
                <span class="case__metric-value">{metric.value}</span>
                <span class="case__metric-label">{metric.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="shell shell--wide case__layout">
      <div class="case__body">
        <Content />
      </div>

      <!-- Sticky on wide screens: project facts and a section list that
           highlights the section being read. -->
      <aside class="case__aside" aria-label="Project details">
        <dl class="case__facts">
          <div>
            <dt>Role</dt>
            <dd>{data.role}</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>
              <ul class="case__stack">
                {data.stack.map((tech) => <li>{tech}</li>)}
              </ul>
            </dd>
          </div>
        </dl>

        {
          sections.length > 1 && (
            <nav class="case__toc" aria-label="On this page" data-toc>
              <p class="case__toc-label">On this page</p>
              <ol>
                {sections.map((section) => (
                  <li>
                    <a href={`#${section.slug}`}>{section.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
    </div>

    <nav class="case__next" aria-label="Next project">
      <a href={`/projects/${next.id}`} style={`--atmosphere: ${next.data.accent}`}>
        <div class="shell shell--wide case__next-inner">
          <div>
            <p class="eyebrow">Next project</p>
            <p class="case__next-title">{next.data.title}</p>
            <p class="case__next-tagline">{next.data.tagline}</p>
          </div>
          <svg viewBox="0 0 14 14" width="20" height="20" aria-hidden="true">
            <path
              d="M2 7h10M12 7l-4-4M12 7l-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </nav>
  </article>
</BaseLayout>

<script>
  // Highlight the section being read: the last heading above the top third.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);
    let queued = false;
    const update = () => {
      queued = false;
      const line = window.innerHeight * 0.3;
      let current: string | null = null;
      for (const target of targets) {
        if (target.getBoundingClientRect().top <= line) current = target.id;
      }
      for (const link of links) {
        if (link.hash.slice(1) === current) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  /* Full site width throughout. The header pairs the overview with the
     project image; the body pairs a readable text column with a sticky
     sidebar, so long lines never get too wide to read. */
  .case {
    position: relative;
  }

  .case__glow {
    position: absolute;
    inset: 0 0 auto;
    height: 70vh;
    background: radial-gradient(
      55% 60% at 70% 0%,
      hsl(var(--atmosphere) / 12%) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  /* --- Header: overview beside the image ---------------------------- */
  .case__hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: var(--space-7);
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out);
  }

  .case__back:hover {
    color: var(--text);
  }

  .case__back svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .case__back:hover svg {
    transform: translateX(-3px);
  }

  .case__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
  }

  .case__eyebrow {
    color: var(--accent);
  }

  .case__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text-secondary);
    font-size: var(--fs-micro);
  }

  .case__status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
  }

  .case__status[data-tone='building']::before {
    background: var(--warning);
  }

  .case__status[data-tone='award']::before {
    background: var(--accent);
  }

  .case__year {
    color: var(--text-muted);
    font-size: var(--fs-micro);
  }

  .case__title {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
  }

  .case__tagline {
    margin-top: var(--space-4);
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .case__links a {
    gap: 0.55rem;
  }

  .case__link-secondary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text);
    font-size: var(--fs-xs);
    font-weight: 500;
    transition:
      border-color var(--dur-fast),
      background var(--dur-fast);
  }

  .case__link-secondary:hover {
    border-color: var(--text-muted);
    background: var(--surface-raised);
  }

  .case__gh {
    display: inline-grid;
    font-size: 1rem;
  }

  .case__source-note {
    margin-top: var(--space-3);
    max-width: 34rem;
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .case__link-host {
    padding-left: 0.55rem;
    border-left: 1px solid rgb(255 255 255 / 30%);
    font-size: var(--fs-micro);
    /* Quieter than the label, but still 4.5:1 on the accent fill (0.8 gave
       4.43:1 at this size). */
    opacity: 0.9;
  }

  /* --- Metrics ------------------------------------------------------- */
  .case__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-5);
    margin-bottom: var(--space-9);
    padding: var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .case__metrics li {
    display: grid;
    gap: var(--space-1);
  }

  .case__metric-value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    line-height: 1.1;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .case__metric-label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* --- Body + sidebar ------------------------------------------------ */
  .case__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    align-items: start;
    gap: clamp(2.5rem, 6vw, 5rem);
    /* Same space before the "Next project" band as before the research
       page's closing band. */
    padding-bottom: var(--section-space);
  }

  .case__aside {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
    display: grid;
    gap: var(--space-6);
  }

  .case__facts {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .case__facts dt,
  .case__toc-label {
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .case__facts dd {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .case__stack li {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .case__toc ol {
    display: grid;
    border-left: 1px solid var(--border);
  }

  .case__toc a {
    display: block;
    margin-left: -1px;
    padding: 0.35rem 0 0.35rem var(--space-4);
    border-left: 2px solid transparent;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.4;
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast);
  }

  .case__toc a:hover {
    color: var(--text);
  }

  .case__toc a[aria-current] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  .case__body {
    min-width: 0;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .case__body > :global(* + *) {
    margin-top: var(--space-5);
  }

  /* 64px between write-up sections on a laptop, easing to 48px on a phone so
     they never sit further apart than the page's own sections (56px there). */
  .case__body > :global(h2) {
    margin-top: clamp(var(--space-8), 5vw, var(--space-9));
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    scroll-margin-top: calc(var(--header-height) + var(--space-6));
  }

  .case__body > :global(h2:first-child) {
    margin-top: 0;
  }

  .case__body > :global(h2 + *) {
    margin-top: var(--space-4);
  }

  .case__body > :global(h3) {
    margin-top: var(--space-7);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text);
  }

  .case__body > :global(h3 + *) {
    margin-top: var(--space-2);
  }

  .case__body > :global(p) {
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .case__body :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .case__body > :global(ul),
  .case__body > :global(ol) {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    color: var(--text-secondary);
  }

  .case__body :global(ul > li) {
    position: relative;
  }

  .case__body > :global(ul) :global(li)::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-5) + 2px);
    top: 0.8em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: hsl(var(--atmosphere) / 80%);
  }

  /* base.css strips list markers; numbered steps get theirs back. */
  .case__body > :global(ol) {
    list-style: decimal;
  }

  .case__body > :global(ol) :global(li)::marker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .case__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color var(--dur) var(--ease-out);
  }

  .case__body :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .case__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--accent);
  }

  .case__body > :global(.callout) {
    margin-top: var(--space-6);
  }

  .case__body > :global(.callout + .callout) {
    margin-top: var(--space-4);
  }

  .case__body > :global(.figure),
  .case__body > :global(.tree),
  .case__body > :global(.pipeline),
  .case__body > :global(.spec) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }

  /* --- Next ---------------------------------------------------------- */
  .case__next {
    border-top: 1px solid var(--border);
  }

  .case__next a {
    display: block;
    padding-block: var(--space-9);
    transition: background-color var(--dur-slow) var(--ease-out);
  }

  .case__next a:hover {
    background: linear-gradient(hsl(var(--atmosphere) / 7%), transparent);
  }

  .case__next-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .case__next-title {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .case__next-tagline {
    margin-top: var(--space-2);
    max-width: 34rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .case__next svg {
    flex-shrink: 0;
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .case__next a:hover svg {
    transform: translateX(6px);
    color: var(--accent);
  }

  /* --- Narrower screens: stack everything ---------------------------- */
  @media (max-width: 61.99rem) {
    .case__hero,
    .case__layout {
      grid-template-columns: 1fr;
    }

    /* Details come before the write-up; the section list is dropped. */
    .case__aside {
      position: static;
      grid-row: 1;
    }

    .case__toc {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .case__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: var(--space-4);
    }

    .case__body {
      font-size: 1rem;
    }

    .case__next a {
      padding-block: var(--space-8);
    }

    .case__next-inner {
      align-items: center;
    }
  }
</style>
