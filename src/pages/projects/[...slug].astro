---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  const ordered = projects.sort((a, b) => a.data.order - b.data.order);

  return ordered.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: ordered[(i + 1) % ordered.length]!,
    },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const displayUrl = data.liveUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');

const meta = [
  { label: 'Year', value: data.year },
  { label: 'Role', value: data.role },
  { label: 'Status', value: data.status },
];
---

<BaseLayout
  title={data.seo?.title ?? data.title}
  description={data.seo?.description ?? data.summary}
  ogImage={`/og/${project.id}.png`}
  type="article"
>
  <article class="case" style={`--atmosphere: ${data.accent}`}>
    <div class="case__glow" aria-hidden="true"></div>

    <header class="case__hero">
      <div class="shell shell--wide">
        <a class="case__back" href="/#work">
          <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
            <path
              d="M12 7H2M2 7l4-4M2 7l4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>All work</span>
        </a>

        <p class="eyebrow case__eyebrow">Case study</p>
        <h1 class="case__title">{data.title}</h1>
        <p class="case__tagline">{data.tagline}</p>

        <div class="case__meta">
          <dl class="case__meta-list">
            {
              meta.map((item) => (
                <div>
                  <dt class="mono">{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))
            }
            <div class="case__meta-stack">
              <dt class="mono">Stack</dt>
              <dd>{data.stack.join(' · ')}</dd>
            </div>
          </dl>

          {
            (data.liveUrl || data.githubUrl) && (
              <ul class="case__links">
                {data.liveUrl && (
                  <li>
                    <a href={data.liveUrl} target="_blank" rel="noopener">
                      <span>{displayUrl}</span>
                      <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                        <path
                          d="M3 9L9 3M9 3H4.5M9 3v4.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </li>
                )}
                {data.githubUrl && (
                  <li>
                    <a href={data.githubUrl} target="_blank" rel="noopener">
                      <span>Source</span>
                      <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                        <path
                          d="M3 9L9 3M9 3H4.5M9 3v4.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.3"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </li>
                )}
              </ul>
            )
          }
        </div>
      </div>
    </header>

    <div class="shell shell--wide case__visual">
      <Figure src={data.heroImage} alt={data.heroAlt} url={displayUrl} ratio="16 / 9" priority />
    </div>

    {
      data.metrics.length > 0 && (
        <div class="shell shell--wide">
          <ul class="case__metrics">
            {data.metrics.map((metric) => (
              <li>
                <span class="case__metric-value mono">{metric.value}</span>
                <span class="case__metric-label">{metric.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="shell shell--wide">
      <div class="case__body">
        <Content />
      </div>
    </div>

    <nav class="case__next" aria-label="Next project">
      <a href={`/projects/${next.id}`} style={`--atmosphere: ${next.data.accent}`}>
        <div class="shell shell--wide case__next-inner">
          <div>
            <p class="eyebrow">Next case study</p>
            <p class="case__next-title">{next.data.title}</p>
            <p class="case__next-tagline">{next.data.tagline}</p>
          </div>
          <svg viewBox="0 0 14 14" width="20" height="20" aria-hidden="true">
            <path
              d="M2 7h10M12 7l-4-4M12 7l-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .case {
    position: relative;
  }

  .case__glow {
    position: absolute;
    inset: 0 0 auto;
    height: 70vh;
    background: radial-gradient(
      55% 60% at 50% 0%,
      hsl(var(--atmosphere) / 10%) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  /* --- Hero ------------------------------------------------------ */
  .case__hero {
    padding-top: calc(var(--header-height) + clamp(3rem, 8vw, 6rem));
    padding-bottom: var(--space-8);
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out);
  }

  .case__back:hover {
    color: var(--text);
  }

  .case__back svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .case__back:hover svg {
    transform: translateX(-3px);
  }

  .case__eyebrow {
    color: hsl(var(--atmosphere) / 90%);
  }

  .case__title {
    margin-top: var(--space-3);
    font-size: var(--fs-hero);
    font-weight: 500;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
  }

  .case__tagline {
    margin-top: var(--space-4);
    max-width: 40rem;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* --- Meta ------------------------------------------------------ */
  .case__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .case__meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
  }

  .case__meta-list div {
    display: grid;
    gap: var(--space-1);
  }

  .case__meta-list dt {
    color: var(--text-faint);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .case__meta-list dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  .case__meta-stack {
    max-width: 26rem;
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .case__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 0.9rem;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .case__links a:hover {
    color: var(--text);
    border-color: hsl(var(--atmosphere) / 45%);
  }

  .case__links svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .case__links a:hover svg {
    transform: translate(1px, -1px);
  }

  /* --- Hero visual ------------------------------------------------ */
  .case__visual {
    margin-bottom: var(--space-9);
  }

  /* --- Metrics ----------------------------------------------------- */
  .case__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-5);
    padding: var(--space-6) 0;
    margin-bottom: var(--space-9);
    border-block: 1px solid var(--border);
  }

  .case__metrics li {
    display: grid;
    gap: var(--space-1);
  }

  .case__metric-value {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .case__metric-label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* --- Body -------------------------------------------------------
     A three-track grid: prose sits in the centre track, while figures
     and diagrams break out to the full content width. */
  .case__body {
    display: grid;
    grid-template-columns:
      [full-start] minmax(0, 1fr)
      [content-start] min(var(--width-prose), 100%) [content-end]
      minmax(0, 1fr) [full-end];
    padding-bottom: var(--space-10);
  }

  .case__body > :global(*) {
    grid-column: content;
    max-width: 100%;
  }

  .case__body > :global(* + *) {
    margin-top: var(--space-5);
  }

  .case__body > :global(h2) {
    grid-column: full;
    margin-top: var(--space-11);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }

  .case__body > :global(h2:first-child) {
    margin-top: 0;
  }

  .case__body > :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text);
  }

  .case__body > :global(p) {
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .case__body :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .case__body > :global(ul) {
    display: grid;
    gap: var(--space-3);
    padding-left: var(--space-5);
    color: var(--text-secondary);
  }

  .case__body :global(ul > li) {
    position: relative;
  }

  .case__body > :global(ul) :global(li)::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-5) + 2px);
    top: 0.78em;
    width: 6px;
    height: 1px;
    background: hsl(var(--atmosphere) / 70%);
  }

  .case__body :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-bright);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur) var(--ease-out);
  }

  .case__body :global(a:hover) {
    text-decoration-color: hsl(var(--atmosphere) / 80%);
  }

  .case__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: hsl(var(--atmosphere) / 95%);
  }

  /* Break out the wide elements. */
  .case__body > :global(.figure),
  .case__body > :global(.tree),
  .case__body > :global(.pipeline),
  .case__body > :global(.spec),
  .case__body > :global(.callout) {
    grid-column: full;
    margin-top: var(--space-7);
    margin-bottom: var(--space-7);
  }

  /* --- Next -------------------------------------------------------- */
  .case__next {
    border-top: 1px solid var(--border);
  }

  .case__next a {
    display: block;
    padding-block: var(--space-9);
    transition: background-color var(--dur-slow) var(--ease-out);
  }

  .case__next a:hover {
    background: linear-gradient(hsl(var(--atmosphere) / 7%), transparent);
  }

  .case__next-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .case__next-title {
    margin-top: var(--space-3);
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
  }

  .case__next-tagline {
    margin-top: var(--space-2);
    max-width: 34rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .case__next svg {
    flex-shrink: 0;
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .case__next a:hover svg {
    transform: translateX(6px);
    color: hsl(var(--atmosphere) / 95%);
  }

  @media (max-width: 47.99rem) {
    .case__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .case__metrics {
      gap: var(--space-4);
    }

    .case__next a {
      padding-block: var(--space-8);
    }

    .case__next-inner {
      align-items: center;
    }
  }
</style>
