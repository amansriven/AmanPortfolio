---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectTile from '../components/ProjectTile.astro';
import CompanyLogo from '../components/CompanyLogo.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { experience, roleId } from '../lib/experience';
import { socials } from '../lib/site';
/* The homepage is a highlight reel: only projects marked `featured` (two).
   /projects is the full, filterable archive. */
const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout isHome>
  <Hero />
  <section class="home-section shell" id="work" aria-labelledby="work-heading">
    <div class="section-heading">
      <div class="section-title">
        <span class="section-index mono" aria-hidden="true">01</span>
        <h2 id="work-heading">Selected work</h2>
      </div>
      <a class="text-link" href="/projects">All projects <span aria-hidden="true">→</span></a>
    </div>
    <div class="work-grid">
      {projects.map((project) => <ProjectTile project={project} />)}
    </div>
  </section>
  <section class="home-section shell" id="experience" aria-labelledby="experience-heading">
    <div class="section-heading">
      <div class="section-title">
        <span class="section-index mono" aria-hidden="true">02</span>
        <h2 id="experience-heading">Along the way</h2>
      </div>
      <a class="text-link" href="/experience">Full experience <span aria-hidden="true">→</span></a>
    </div>
    <ul class="experience-list">
      {
        experience.slice(0, 3).map((role) => (
          <li>
            <>
              <CompanyLogo role={role} size={2.25} />
              <div class="experience-list__who">
                <>
                  <h3>{role.org}</h3>
                  <p>{role.role}</p>
                  {role.highlight && (
                    <a class="experience-list__highlight" href={`/experience#${roleId(role)}`}>
                      {role.highlight}
                    </a>
                  )}
                </>
              </div>
              <span class="mono">{role.period}</span>
            </>
          </li>
        ))
      }
    </ul>
  </section>
  <section class="shell closing-wrap" aria-labelledby="contact-heading">
    <div class="closing">
      <div>
        <p class="eyebrow">Have something in mind?</p>
        <h2 id="contact-heading">Let’s make it happen.</h2>
      </div>
      <div class="closing__actions">
        <a class="button-primary" href="/contact">Get in touch <span aria-hidden="true">→</span></a>
        <ul class="closing__socials" aria-label="Elsewhere">
          {
            socials.map((social) => (
              <li>
                <a
                  class="social-circle"
                  data-brand={social.label.toLowerCase()}
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener"
                  aria-label={social.label}
                  title={social.label}
                >
                  <SocialIcon label={social.label} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  // Preserve incoming links to sections that now have their own pages.
  const legacy: Record<string, string> = {
    '#about': '/about',
    '#research': '/research',
    '#contact': '/contact',
  };
  const redirectLegacyHash = () => {
    const target = legacy[window.location.hash];
    if (target) window.location.replace(target);
  };
  redirectLegacyHash();
  window.addEventListener('hashchange', redirectLegacyHash);
</script>
<style>
  .home-section {
    padding-bottom: var(--section-space);
  }
  .section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--border-strong);
    padding-top: 1.4rem;
    margin-bottom: 1.5rem;
  }
  .section-title {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  /* Small mono counters give the page a visible order. */
  .section-index {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  h2 {
    font: 400 clamp(1.8rem, 3vw, 2.3rem) var(--font-display);
    letter-spacing: -0.03em;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 47.99rem) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
  .experience-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .experience-list__who {
    flex: 1;
    min-width: 0;
  }
  .experience-list h3 {
    font-size: 1rem;
    font-weight: 500;
  }
  .experience-list p {
    margin-top: 0.3rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }
  /* Quiet on purpose: muted like the role line, with a faint underline that
     says "link" without competing with the row. */
  .experience-list__highlight {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: 0.2rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition:
      color var(--dur-fast),
      text-decoration-color var(--dur-fast);
  }
  .experience-list__highlight:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  .experience-list .mono {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-align: right;
  }
  /* --- Closing panel ------------------------------------------------ */
  .closing-wrap {
    padding-bottom: var(--section-space);
  }
  .closing {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 3.5rem);
    background: linear-gradient(135deg, var(--accent-dim), var(--surface) 70%);
    border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
    border-radius: 16px;
  }
  /* The hero's dot grid, fading in from the right. */
  .closing::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(
      color-mix(in srgb, var(--accent) 35%, transparent) 1px,
      transparent 1.6px
    );
    background-size: 20px 20px;
    mask-image: linear-gradient(90deg, transparent 35%, #000);
  }
  .closing h2 {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 4.2vw, 3rem);
    line-height: 1.1;
  }
  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .closing__socials {
    display: flex;
    gap: 0.6rem;
  }
</style>
