---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContents from '../components/PageContents.astro';
import SectionHead from '../components/SectionHead.astro';
import ModelDiagram from '../components/ModelDiagram.astro';
import MetricSpans from '../components/MetricSpans.astro';
import PaperCover from '../components/PaperCover.astro';
import PaperShelf from '../components/PaperShelf.astro';
import CiteBlock from '../components/CiteBlock.astro';
import { paper, headline, macro, ablation } from '../lib/research';

const facts = [
  { label: 'Period', value: paper.period },
  { label: 'Context', value: paper.venue },
  { label: 'Dataset', value: 'BCCC-SCsVul-2024' },
  { label: 'Recognition', value: paper.award },
];

/* Quoted in Results; read from the data so the two can't drift apart. */
const singleModel = ablation.find((row) => row.name === 'Single model')!;
---

<BaseLayout
  title={`${paper.acronym} — ${paper.subtitle}`}
  description="SCRAN: an ensemble residual-attention network for multi-label smart contract vulnerability detection across 111,897 Solidity contracts. Undergraduate research at Texas A&M, with the paper and every per-class number on the page."
  ogImage="/og/research.png"
  type="article"
>
  <article class="paper" style={`--atmosphere: ${paper.accent}`}>
    <div class="paper__glow" aria-hidden="true"></div>

    <!-- ============ Masthead ============ -->
    <header class="paper__masthead">
      <div class="shell shell--wide">
        <a class="paper__back" href="/">
          <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
            <path
              d="M12 7H2M2 7l4-4M2 7l4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>Back to the portfolio</span>
        </a>

        <div class="masthead">
          <div class="masthead__text">
            <p class="eyebrow paper__eyebrow">Research paper</p>

            <h1 class="paper__title">
              {paper.title}
              <span class="paper__acronym mono">{paper.acronym}</span>
            </h1>

            <p class="paper__subtitle">{paper.subtitle}</p>

            <ul class="authors">
              {
                paper.authors.map((author) => (
                  <li class="author" data-self={author.self ? '' : undefined}>
                    <p class="author__name">{author.name}</p>
                    <p class="author__where">
                      {author.department}, {author.institution}
                    </p>
                    <p class="author__contact mono">
                      {author.location} · {author.email}
                    </p>
                  </li>
                ))
              }
            </ul>

            <div class="paper__actions">
              <a class="action action--primary" href={paper.href} target="_blank" rel="noopener">
                <span>Read the paper</span>
                <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                  <path
                    d="M3 9L9 3M9 3H4.5M9 3v4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </a>
              <a class="action" href={paper.href} download>
                <span>Download PDF</span>
                <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                  <path
                    d="M6 2v6.5M6 8.5 3.5 6M6 8.5 8.5 6M2.5 10h7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </a>
            </div>
          </div>

          <div class="masthead__cover" data-reveal>
            <PaperCover />
          </div>
        </div>

        <dl class="facts">
          {
            facts.map((fact) => (
              <div class="facts__row">
                <dt class="mono">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <!-- ============ Headline numbers ============ -->
    <div class="shell shell--wide">
      <ul class="headline" data-reveal>
        {
          headline.map((metric) => (
            <li>
              <span class="headline__value mono">{metric.value}</span>
              <span class="headline__label">{metric.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ============ Contents ============ -->
    <!-- The page is the short version. Dataset and training details, the
         ablation table, and the cross-corpus comparisons live in the paper. -->
    <PageContents
      items={[
        { label: 'In brief', href: '#summary-heading' },
        { label: 'Results', href: '#results-heading' },
        { label: 'Architecture', href: '#architecture-heading' },
        { label: 'Limits', href: '#limits-heading' },
        { label: 'Paper & citation', href: '#paper-heading' },
      ]}
    />

    <!-- ============ 01 Summary ============ -->
    <section class="section paper__section paper__section--first" aria-labelledby="summary-heading">
      <div class="shell shell--wide">
        <SectionHead
          index="01"
          title="In brief"
          meta={paper.indexTerms.slice(0, 3).join(' · ')}
          id="summary-heading"
        />

        <div class="abstract__body" data-reveal>
          <p class="abstract__text">
            SCRAN reads a Solidity smart contract, reduced to 240 static features, and flags which
            of eleven vulnerability classes it contains. A contract can carry several at once, so
            each class gets its own independent answer.
          </p>
          <p class="abstract__more">
            The hard part is imbalance: some classes appear in under one percent of the 111,897
            contracts in BCCC-SCsVul-2024. Focal loss, oversampling, and per-class thresholds do
            most of the work, and a three-model ensemble steadies the result. On a held-out test
            split that never saw resampling or threshold tuning, it reaches a macro F1 of {
              macro.f1.toFixed(4)
            } and a macro AUC of {macro.auc.toFixed(4)}.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ 02 Results ============ -->
    <section class="section paper__section" aria-labelledby="results-heading">
      <div class="shell shell--wide">
        <SectionHead
          index="02"
          title="Results"
          meta="Held-out test split · 20% of the corpus"
          id="results-heading"
        />

        <div class="paper__block" data-reveal>
          <MetricSpans />
        </div>

        <div class="paper__prose" data-reveal>
          <p>
            The shape of that chart is the finding. Recall never drops below 0.89, so the model
            rarely misses a vulnerability that is present. Precision is what varies, and every long
            span is a class the model over-reports. Timestamp dependence is the worst at 0.5434
            precision: close to one wrong flag for every right one.
          </p>
          <p>
            AUC stays above 0.99 everywhere, including those weak classes. The ranking is good even
            where the decision is not, so the failure is in where the threshold lands rather than in
            what the network learned.
          </p>
          <p>
            One trade is worth stating: a single model scores a slightly higher macro F1 ({
              singleModel.f1?.toFixed(4)
            }) than the ensemble ({macro.f1.toFixed(4)}). The ensemble was kept for its higher AUC
            and steadier behaviour on the rare classes.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ 03 Architecture ============ -->
    <section class="section paper__section" aria-labelledby="architecture-heading">
      <div class="shell shell--wide">
        <SectionHead
          index="03"
          title="Architecture"
          meta="Residual · Attention · Class-specific heads"
          id="architecture-heading"
        />

        <p class="paper__lead" data-reveal>
          A contract arrives as 240 numbers. The question is which of eleven failure modes those
          numbers imply — and a contract can be guilty of several at once, so the eleven answers
          have to be independent rather than a single choice among classes.
        </p>

        <div class="paper__block" data-reveal>
          <ModelDiagram />
        </div>
      </div>
    </section>

    <!-- ============ 04 Limits ============ -->
    <section class="section paper__section" aria-labelledby="limits-heading">
      <div class="shell shell--wide">
        <SectionHead
          index="04"
          title="Limits"
          meta="And what I would do next"
          id="limits-heading"
        />

        <div class="paper__prose" data-reveal>
          <p>
            The model never sees a contract, only 240 numbers extracted from one. That is why the
            classes it struggles with are the ones defined by execution context rather than
            structure. Dynamic traces or a graph encoder over the control-flow graph would give it
            what it is missing, and that is the first change I would make.
          </p>
          <p>
            Every number here comes from one corpus, and SCRAN trades away some explainability: its
            attention heads say which features mattered, which is not a reason an auditor can act
            on. The paper covers both, along with the comparisons against prior work.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ 05 The paper ============ -->
    <section class="section paper__section" aria-labelledby="paper-heading">
      <div class="shell shell--wide">
        <SectionHead
          index="05"
          title="The paper"
          meta={`${paper.pages} pages · PDF`}
          id="paper-heading"
        />

        <div data-reveal>
          <PaperShelf />
        </div>

        <div class="paper__closing" data-reveal>
          <CiteBlock />

          <div class="paper__thanks">
            <p class="eyebrow">Acknowledgements</p>
            <p>
              Written with Dr. Irfan Khan, who advised the work throughout MARE 491, and with help
              from graduate students Zahid Hussain and Shorya Agarwal.
            </p>
            <a class="action action--primary" href={paper.href} target="_blank" rel="noopener">
              <span>Read the paper</span>
              <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                <path
                  d="M3 9L9 3M9 3H4.5M9 3v4.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ Onward ============ -->
    <nav class="paper__next" aria-label="Continue">
      <a href="/projects">
        <div class="shell shell--wide paper__next-inner">
          <div>
            <p class="eyebrow">Back to</p>
            <p class="paper__next-title">Selected work</p>
            <p class="paper__next-tagline">
              Four projects — the systems this research sits next to.
            </p>
          </div>
          <svg viewBox="0 0 14 14" width="20" height="20" aria-hidden="true">
            <path
              d="M2 7h10M12 7l-4-4M12 7l-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .paper {
    position: relative;
  }

  .paper__glow {
    position: absolute;
    inset: 0 0 auto;
    height: 80vh;
    pointer-events: none;
    background: radial-gradient(
      58% 62% at 50% 0%,
      hsl(var(--atmosphere) / 11%) 0%,
      transparent 72%
    );
  }

  /* --- Masthead --------------------------------------------------- */
  .paper__masthead {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: var(--space-9);
  }

  .paper__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out);
  }

  .paper__back:hover {
    color: var(--text);
  }

  .paper__back svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .paper__back:hover svg {
    transform: translateX(-3px);
  }

  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .paper__eyebrow {
    color: var(--accent);
  }

  .paper__title {
    margin-top: var(--space-3);
    font-size: var(--fs-h1);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .paper__acronym {
    display: inline-block;
    transform: translateY(-0.35em);
    margin-left: 0.5rem;
    padding: 0.2rem 0.6rem;
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    vertical-align: baseline;
    color: var(--accent);
    background: hsl(var(--atmosphere) / 12%);
    border: 1px solid hsl(var(--atmosphere) / 32%);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .paper__subtitle {
    margin-top: var(--space-4);
    max-width: 36rem;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--text-secondary);
  }

  /* --- Authors ---------------------------------------------------- */
  .authors {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .author {
    padding-left: var(--space-4);
    border-left: 1px solid var(--border);
  }

  .author[data-self] {
    border-left-color: var(--accent);
  }

  .author__name {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text);
  }

  .author[data-self] .author__name {
    color: var(--accent);
  }

  .author__where {
    margin-top: 1px;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }

  .author__contact {
    margin-top: 2px;
    font-size: var(--fs-micro);
    color: var(--text-faint);
  }

  /* --- Actions ---------------------------------------------------- */
  .paper__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem 1.1rem;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .action:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .action--primary {
    color: var(--text);
    background: hsl(var(--atmosphere) / 14%);
    border-color: var(--accent);
  }

  .action--primary:hover {
    background: hsl(var(--atmosphere) / 22%);
    border-color: var(--accent);
  }

  .action svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .action--primary:hover svg {
    transform: translate(1px, -1px);
  }

  .masthead__cover {
    display: flex;
    /* The stack sheets are translated and rotated outward, so the column needs
       room on the right or the paper runs into the page gutter. */
    justify-content: flex-end;
    padding-right: var(--space-6);
  }

  /* --- Facts rail -------------------------------------------------- */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .facts__row {
    display: grid;
    gap: var(--space-1);
  }

  .facts__row dt {
    color: var(--text-faint);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .facts__row dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  /* --- Headline numbers -------------------------------------------- */
  .headline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    padding: var(--space-6) 0;
    border-block: 1px solid var(--border);
  }

  .headline li {
    display: grid;
    gap: var(--space-1);
  }

  .headline__value {
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .headline__label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  /* --- Section scaffolding ------------------------------------------ */
  /* One gap between sections rather than one from each side: the same
     --section-space the homepage uses. */
  .paper__section {
    padding-block: var(--section-space);
  }

  .paper__section + .paper__section {
    padding-top: 0;
  }

  /* The contents bar above already separates the first section from the
     headline numbers. */
  .paper__section--first {
    padding-top: 0;
  }

  .paper__lead {
    max-width: 44rem;
    margin-bottom: var(--space-8);
    font-size: var(--fs-lead);
    line-height: 1.5;
    letter-spacing: var(--tracking-tight);
    color: var(--text);
  }

  .paper__lead em {
    font-style: italic;
    color: var(--accent);
  }

  .paper__block {
    margin-top: var(--space-8);
  }

  .paper__prose {
    display: grid;
    gap: var(--space-5);
    max-width: 42rem;
    margin-top: var(--space-9);
    color: var(--text-secondary);
  }

  /* Blocks carry a top margin for spacing them after other content. Straight
     under a section heading they sit at the heading's own 32px instead. */
  :global(.head) + .paper__block,
  :global(.head) + .paper__prose {
    margin-top: 0;
  }

  /* --- Summary ------------------------------------------------------ */
  .abstract__body {
    display: grid;
    gap: var(--space-5);
    max-width: 42rem;
  }

  .abstract__text {
    max-width: 42rem;
    font-size: var(--fs-lead);
    line-height: 1.62;
    letter-spacing: var(--tracking-normal);
    color: var(--text-secondary);
  }

  /* A single accent initial. The paper has a run-in "Abstract—"; this is the
     web equivalent, and it gives the block a place to start. */
  .abstract__text::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-size: 3.1em;
    line-height: 0.86;
    font-weight: 500;
    color: var(--accent);
  }

  .abstract__more {
    color: var(--text-secondary);
    line-height: 1.75;
  }

  /* --- Closing --------------------------------------------------------- */
  .paper__closing {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
    margin-top: var(--space-9);
  }

  .paper__thanks {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-top: var(--space-2);
  }

  .paper__thanks p:not(.eyebrow) {
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 30rem;
  }

  /* --- Onward ---------------------------------------------------------- */
  .paper__next {
    border-top: 1px solid var(--border);
  }

  .paper__next a {
    display: block;
    padding-block: var(--space-9);
    transition: background-color var(--dur-slow) var(--ease-out);
  }

  .paper__next a:hover {
    background: linear-gradient(hsl(var(--atmosphere) / 7%), transparent);
  }

  .paper__next-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .paper__next-title {
    margin-top: var(--space-3);
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
  }

  .paper__next-tagline {
    margin-top: var(--space-2);
    max-width: 34rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .paper__next svg {
    flex-shrink: 0;
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .paper__next a:hover svg {
    transform: translateX(6px);
    color: var(--accent);
  }

  /* --- Responsive ------------------------------------------------------- */
  @media (max-width: 61.99rem) {
    .masthead {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    /* The cover follows the type on narrow screens. Leading with it pushed the
       title more than a screen down, which is the wrong first thing to read. */
    .masthead__cover {
      justify-content: center;
      padding-right: 0;
    }

    .facts,
    .headline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-4);
    }

    .paper__closing {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 35.99rem) {
    .paper__acronym {
      transform: none;
      margin-left: 0;
      margin-top: var(--space-3);
      display: block;
      width: fit-content;
    }
  }
</style>
