---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to the social preview image. */
  ogImage?: string;
  /** `article` for case studies, `website` elsewhere. */
  type?: 'website' | 'article';
  /** Set on the homepage so the header brand is not a redundant link. */
  isHome?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og/default.png',
  type = 'website',
  isHome = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.school },
  sameAs: ['https://github.com/amansriven', 'https://linkedin.com/in/aman-sriven'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0b0c" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    <!-- Cloudflare Web Analytics. Replace the token, then remove this comment.
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "REPLACE_WITH_YOUR_CLOUDFLARE_ANALYTICS_TOKEN"}'></script>
    -->
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      import { initReveal } from '../lib/reveal';
      initReveal();
    </script>
  </body>
</html>
