---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Lightbox from '../components/Lightbox.astro';
import BackToTop from '../components/BackToTop.astro';
import PostHog from '../components/PostHog.astro';
import { cleanPath, site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to the social preview image. */
  ogImage?: string;
  /** `article` for project pages, `website` elsewhere. */
  type?: 'website' | 'article';
  /** Set on the homepage so the header brand is not a redundant link. */
  isHome?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og/default.png',
  type = 'website',
  isHome = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(cleanPath(Astro.url.pathname), site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
/* Analytics is optional and production-only, so dev visits never count and a
   fork without PostHog builds fine. */
const posthogKey = import.meta.env.PROD ? import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN : undefined;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.school },
  sameAs: ['https://github.com/amansriven', 'https://linkedin.com/in/aman-sriven'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- `?v=` busts browsers' stubborn favicon cache; bump it when the icons change. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <!-- Google Search wants a favicon sized in multiples of 48px; the 32px .ico doesn't qualify. -->
    <link rel="icon" href="/icon-192.png?v=2" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf8f5" />
    <!-- Sets the theme before first paint so dark-mode visitors never see a white
         flash. Saved choice wins; otherwise follow the system, live. Keep the
         colours in step with src/lib/theme.ts. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const saved = () => {
          try {
            const t = localStorage.getItem('theme');
            return t === 'light' || t === 'dark' ? t : null;
          } catch {
            return null;
          }
        };
        const set = (theme) => {
          root.dataset.theme = theme;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = theme === 'dark' ? '#1b1617' : '#faf8f5';
        };
        set(saved() ?? (media.matches ? 'dark' : 'light'));
        media.addEventListener('change', (e) => {
          if (!saved()) set(e.matches ? 'dark' : 'light');
        });
      })();
    </script>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    {posthogKey && posthogHost && <PostHog apiKey={posthogKey} apiHost={posthogHost} />}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />
    <Lightbox />
    <BackToTop />

    <script>
      import { initReveal } from '../lib/reveal';
      import { initSpotlight } from '../lib/effects';
      initReveal();
      initSpotlight();
    </script>
  </body>
</html>
