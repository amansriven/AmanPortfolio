---
/**
 * Appears once the reader is a screen or so down the page. The ring around
 * it fills with scroll progress; clicking returns to the top.
 */
const r = 20;
const circumference = +(2 * Math.PI * r).toFixed(2);
---

<button class="to-top" type="button" aria-label="Back to top" data-to-top>
  <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
    <circle class="to-top__track" cx="24" cy="24" r={r}></circle>
    <circle
      class="to-top__ring"
      cx="24"
      cy="24"
      r={r}
      style={`--c: ${circumference}`}
      data-to-top-ring></circle>
    <path
      d="M24 30V18m0 0-5 5m5-5 5 5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-to-top]');
  const ring = document.querySelector<SVGCircleElement>('[data-to-top-ring]');

  if (button && ring) {
    let queued = false;
    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const progress = max > 0 ? window.scrollY / max : 0;
      ring.style.setProperty('--p', progress.toFixed(4));
      button.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.8);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();

    button.addEventListener('click', () => {
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
      // Put keyboard focus back at the start of the page.
      document.querySelector<HTMLElement>('.skip-link')?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 90;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: var(--accent);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 24px -12px rgb(var(--shadow-rgb) / 40%);
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      background var(--dur-fast);
  }

  .to-top.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .to-top:hover {
    background: var(--accent-dim);
  }

  .to-top path {
    transition: transform var(--dur) var(--ease-out);
  }

  .to-top:hover path {
    transform: translateY(-2px);
  }

  .to-top circle {
    fill: none;
    stroke-width: 2;
  }

  .to-top__track {
    stroke: var(--border);
  }

  /* Start the ring at twelve o'clock. */
  .to-top__ring {
    transform: rotate(-90deg);
    transform-origin: 24px 24px;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-dasharray: var(--c);
    stroke-dashoffset: calc(var(--c) * (1 - var(--p, 0)));
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transition: opacity var(--dur);
      transform: none;
    }
  }
</style>
