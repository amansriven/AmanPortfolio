---
import ProjectFeature from './ProjectFeature.astro';
import SectionHead from './SectionHead.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;

/* First project leads full-width; the rest alternate sides. */
function layoutFor(index: number): 'lead' | 'split' | 'split-reverse' {
  if (index === 0) return 'lead';
  return index % 2 === 1 ? 'split' : 'split-reverse';
}
---

<section class="section work" id="work" aria-labelledby="work-heading">
  <div class="shell shell--wide">
    <SectionHead
      index="01"
      title="Selected work"
      meta={`${projects.length} case studies`}
      id="work-heading"
    />

    <div class="work__list">
      {
        projects.map((project, i) => (
          <ProjectFeature project={project} index={i} layout={layoutFor(i)} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .work__list {
    display: grid;
    gap: clamp(5rem, 11vw, 9.5rem);
  }
</style>
