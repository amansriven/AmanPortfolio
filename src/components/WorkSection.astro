---
import ProjectFeature from './ProjectFeature.astro';
import SectionHead from './SectionHead.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<section class="section work" id="work" aria-labelledby="work-heading">
  <div class="shell shell--wide">
    <SectionHead
      index="01"
      title="Projects"
      meta={`${projects.length} case studies`}
      id="work-heading"
    />

    <div class="work__list">
      {projects.map((project, i) => <ProjectFeature project={project} index={i} />)}
    </div>
  </div>
</section>

<style>
  .work__list {
    display: grid;
    gap: var(--space-7);
  }
</style>
