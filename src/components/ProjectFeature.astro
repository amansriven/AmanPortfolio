---
import Figure from './Figure.astro';
import { projectLinks } from '../lib/links';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  /** `lead` is the full-width opener; the others alternate sides. */
  layout: 'lead' | 'split' | 'split-reverse';
}

const { project, index, layout } = Astro.props;
const { data } = project;
const href = `/projects/${project.id}`;
const displayUrl = data.liveUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');
const links = projectLinks(data);
---

<article class="feature" data-layout={layout} style={`--atmosphere: ${data.accent}`} data-reveal>
  <div class="feature__glow" aria-hidden="true"></div>

  <div class="feature__media">
    <Figure
      src={data.heroImage}
      alt={data.heroAlt}
      frame={data.heroFrame}
      url={data.heroFrame === 'browser' ? displayUrl : undefined}
      ratio={data.heroFit === 'contain' ? data.heroRatio : layout === 'lead' ? '16 / 9' : '4 / 3'}
      fit={data.heroFit}
      priority={index === 0}
    />
  </div>

  <div class="feature__body">
    <header class="feature__head">
      <p class="feature__index mono">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <span class="feature__status">{data.status}</span>
      </p>
      <h3 class="feature__title">
        <a href={href}>{data.title}</a>
      </h3>
      <p class="feature__tagline">{data.tagline}</p>
    </header>

    <div class="feature__detail">
      <p class="feature__summary">{data.summary}</p>

      {
        data.metrics.length > 0 && (
          <ul class="feature__metrics">
            {data.metrics.map((metric) => (
              <li>
                <span class="feature__metric-value">{metric.value}</span>
                <span class="feature__metric-label">{metric.label}</span>
              </li>
            ))}
          </ul>
        )
      }

      <footer class="feature__foot">
        <ul class="feature__stack mono">
          {data.stack.map((tech) => <li>{tech}</li>)}
        </ul>
        <ul class="feature__actions">
          {
            links.map((link) => (
              <li>
                <a
                  class:list={[
                    'feature__action',
                    { 'feature__action--primary': link.kind === 'live' },
                  ]}
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${data.title} — ${link.label}`}
                >
                  {link.kind === 'source' ? (
                    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                      <path
                        d="M8 .8a7.2 7.2 0 0 0-2.28 14.03c.36.07.49-.16.49-.35v-1.23c-2 .43-2.42-.97-2.42-.97-.33-.83-.8-1.05-.8-1.05-.66-.45.05-.44.05-.44.72.05 1.1.74 1.1.74.65 1.1 1.7.79 2.11.6.07-.47.25-.79.46-.97-1.6-.18-3.28-.8-3.28-3.56 0-.79.28-1.43.74-1.93-.07-.18-.32-.92.07-1.91 0 0 .6-.19 1.98.74a6.9 6.9 0 0 1 3.6 0c1.37-.93 1.98-.74 1.98-.74.39.99.14 1.73.07 1.91.46.5.74 1.14.74 1.93 0 2.77-1.69 3.38-3.3 3.56.26.22.49.66.49 1.33v1.98c0 .19.13.42.5.35A7.2 7.2 0 0 0 8 .8Z"
                        fill="currentColor"
                      />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                      <path
                        d="M3 9L9 3M9 3H4.5M9 3v4.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a class="feature__action feature__action--quiet" href={href}>
              <span>Case study</span>
              <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
                <path
                  d="M2 7h10M12 7l-4-4M12 7l-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </li>
        </ul>
      </footer>
    </div>
  </div>
</article>

<style>
  .feature {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  /* --- Ambient tint -------------------------------------------
     A very low-opacity wash keyed to the project, bleeding past the
     card edges so the surrounding page shifts rather than the card. */
  .feature__glow {
    position: absolute;
    inset: -18% -14%;
    z-index: -1;
    background: radial-gradient(
      52% 58% at 50% 42%,
      hsl(var(--atmosphere) / 11%) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }

  .feature:hover .feature__glow,
  .feature:focus-within .feature__glow {
    opacity: 1;
  }

  /* --- Media --------------------------------------------------- */
  .feature__media {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .feature:hover .feature__media {
    transform: translateY(-6px);
  }

  .feature__media :global(.figure__frame) {
    transition:
      border-color var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out);
  }

  .feature:hover .feature__media :global(.figure__frame) {
    border-color: hsl(var(--atmosphere) / 32%);
    box-shadow: var(--shadow-lg);
  }

  .feature__media :global(.figure__well img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .feature:hover .feature__media :global(.figure__well img) {
    transform: scale(1.02);
  }

  /* --- Body ---------------------------------------------------- */
  .feature__body {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  /* Transparent in the split layouts so the body grid still spaces each
     child directly; becomes a real column in `lead` below. */
  .feature__detail {
    display: contents;
  }

  .feature__index {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-faint);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--fs-micro);
  }

  .feature__status {
    padding: 0.15rem 0.55rem;
    color: hsl(var(--atmosphere) / 95%);
    background: hsl(var(--atmosphere) / 12%);
    border-radius: var(--radius-full);
  }

  .feature__title {
    margin-top: var(--space-3);
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
  }

  /* One anchor per card, stretched across the whole article. */
  .feature__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .feature__tagline {
    margin-top: var(--space-2);
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .feature__summary {
    max-width: 44rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  /* --- Metrics -------------------------------------------------- */
  .feature__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-top: var(--space-2);
  }

  .feature__metrics li {
    display: grid;
    gap: 2px;
  }

  .feature__metric-value {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    color: var(--text);
  }

  .feature__metric-label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  /* --- Footer --------------------------------------------------- */
  .feature__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .feature__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--text-faint);
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
  }

  /* --- Actions --------------------------------------------------
     Real buttons, lifted above the stretched title anchor so each one is
     its own click target rather than falling through to the case study. */
  .feature__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .feature__action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.45rem 0.9rem;
    font-size: var(--fs-xs);
    font-weight: 500;
    white-space: nowrap;
    color: var(--text-secondary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .feature__action:hover {
    color: var(--text);
    border-color: hsl(var(--atmosphere) / 55%);
    background: hsl(var(--atmosphere) / 8%);
  }

  .feature__action--primary {
    color: var(--bg-deep);
    background: var(--text);
    border-color: var(--text);
  }

  .feature__action--primary:hover {
    color: var(--bg-deep);
    background: #fff;
    border-color: #fff;
  }

  .feature__action--quiet {
    border-color: transparent;
  }

  .feature__action svg {
    flex-shrink: 0;
    transition: transform var(--dur) var(--ease-out);
  }

  .feature__action:not(.feature__action--quiet):hover svg {
    transform: translate(1px, -1px);
  }

  .feature__action--quiet:hover svg {
    transform: translateX(3px);
  }

  /* --- Layouts -------------------------------------------------- */
  @media (min-width: 62rem) {
    .feature[data-layout='lead'] {
      gap: var(--space-8);
    }

    .feature[data-layout='lead'] .feature__body {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      column-gap: var(--space-9);
      align-items: start;
    }

    .feature[data-layout='lead'] .feature__detail {
      display: grid;
      gap: var(--space-5);
      align-content: start;
    }

    .feature[data-layout='lead'] .feature__title {
      font-size: var(--fs-h1);
    }

    .feature[data-layout='split'],
    .feature[data-layout='split-reverse'] {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-9);
    }

    .feature[data-layout='split-reverse'] .feature__media {
      order: 2;
    }

    .feature[data-layout='split-reverse'] .feature__body {
      order: 1;
    }
  }

  @media (max-width: 61.99rem) {
    .feature__metrics {
      gap: var(--space-5);
    }
  }
</style>
