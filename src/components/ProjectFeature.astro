---
import Figure from './Figure.astro';
import SocialIcon from './SocialIcon.astro';
import { projectLinks, statusTone } from '../lib/links';
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  compact?: boolean;
}
const { project, compact = false } = Astro.props;
const { data } = project;
const href = `/projects/${project.id}`;
const links = projectLinks(data);

/* A short, readable stack beats a wrapped wall of names. */
const maxTags = compact ? 3 : 4;
const tags = data.stack.slice(0, maxTags);
const extraTags = data.stack.length - tags.length;

const tone = statusTone(data.status);
---

<article
  class:list={['project', 'spotlight', { 'project--compact': compact }]}
  style={`--tint: ${data.accent}`}
  data-stack={JSON.stringify(data.stack)}
>
  <div class="project__visual" data-fit={data.heroFit}>
    <Figure src={data.heroImage} alt="" frame="plain" ratio="16 / 9" fit={data.heroFit} />
  </div>
  <div class="project__body">
    <p class="project__meta">
      <span class="project__status" data-tone={tone}>{data.status}</span>
      <span class="mono">{data.year}</span>
    </p>
    <h3><a class="project__link" href={href}>{data.title}</a></h3>
    <p class="project__description">{data.tagline}</p>
    {
      !compact && data.metrics.length > 0 && (
        <dl class="project__metrics">
          {data.metrics.map((metric) => (
            <div>
              <dt>{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <ul class="project__stack" aria-label="Technologies">
      {tags.map((tech) => <li>{tech}</li>)}
      {
        extraTags > 0 && (
          <li class="project__more" title={data.stack.slice(maxTags).join(', ')}>
            +{extraTags}
          </li>
        )
      }
    </ul>
    {
      !compact && (
        <div class="project__links">
          <span class="text-link project__cta" aria-hidden="true">
            View project <span>→</span>
          </span>
          {links.length > 0 && (
            <ul class="project__external">
              {links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.kind === 'source' ? (
                      <span class="social-circle social-circle--sm" data-brand="github">
                        <SocialIcon label="GitHub" />
                      </span>
                    ) : null}
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </div>
</article>
<style>
  .project {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem;
    align-items: center;
    padding-block: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .project:first-child {
    padding-top: 0;
  }
  .project__visual {
    display: block;
    padding: 0.6rem;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color var(--dur) var(--ease-out);
  }
  .project__visual :global(.figure__frame) {
    border-radius: 3px;
    box-shadow: none;
    border: 0;
  }
  /* Screenshots fill the frame from the top instead of shrinking inside it. */
  .project__visual :global(.figure__well img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  /* Portrait shots stay whole, on a panel tinted with the project's colour
     rather than empty beige bands. */
  .project__visual[data-fit='contain'] :global(.figure__well) {
    background: hsl(var(--tint) / 16%);
  }
  .project:hover .project__visual {
    border-color: var(--border-strong);
  }
  .project:hover .project__visual :global(.figure__well img) {
    transform: scale(1.02);
  }
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.7rem;
  }
  .project__meta .mono {
    font-size: 0.7rem;
  }
  .project__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.55rem 0.15rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-secondary);
  }
  .project__status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
  }
  .project__status[data-tone='building']::before {
    background: #b7791f;
  }
  .project__status[data-tone='award']::before {
    background: var(--accent);
  }
  h3 {
    margin-top: 0.7rem;
    font: 400 1.75rem var(--font-display);
    letter-spacing: -0.03em;
  }
  /* The title link covers the whole card: one target, one tab stop. */
  .project__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .project:hover h3 {
    color: var(--accent);
  }
  .project:has(.project__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .project__link:focus-visible {
    outline: none;
  }
  .project__description {
    margin-top: 0.7rem;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: 1.7;
  }
  /* Fixed columns, so values line up from one card to the next. */
  .project__metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .project__metrics div {
    display: flex;
    flex-direction: column-reverse;
    /* column-reverse flips the axis: this pins values to the top. */
    justify-content: flex-end;
    gap: 0.2rem;
  }
  .project__metrics dd {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
  }
  .project__metrics dt {
    font-size: 0.7rem;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }
  .project__stack li {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0;
  }
  .project__stack .project__more {
    color: var(--text-muted);
  }
  .project__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.2rem;
    margin-top: 1.25rem;
  }
  .project:hover .project__cta span {
    transform: translateX(3px);
  }
  .project__cta span {
    transition: transform var(--dur) var(--ease-out);
  }
  .project__external {
    display: flex;
    gap: 1.2rem;
  }
  /* External links sit above the card-wide link. */
  .project__external a {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    transition: color var(--dur-fast);
  }
  .project__external a:hover {
    color: var(--text);
  }
  .project--compact {
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 1.75rem;
    padding-block: 1.5rem;
  }
  .project--compact h3 {
    font-size: 1.5rem;
    margin-top: 0.5rem;
  }
  .project--compact .project__description {
    font-size: var(--fs-xs);
    margin-top: 0.4rem;
  }
  .project--compact .project__stack {
    margin-top: 0.75rem;
  }
  @media (max-width: 47.99rem) {
    .project,
    .project--compact {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project:hover .project__visual :global(.figure__well img) {
      transform: none;
    }
  }
</style>
