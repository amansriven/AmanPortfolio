---
import Figure from './Figure.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  /** `lead` is the full-width opener; the others alternate sides. */
  layout: 'lead' | 'split' | 'split-reverse';
}

const { project, index, layout } = Astro.props;
const { data } = project;
const href = `/projects/${project.id}`;
const displayUrl = data.liveUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<article class="feature" data-layout={layout} style={`--atmosphere: ${data.accent}`} data-reveal>
  <div class="feature__glow" aria-hidden="true"></div>

  <div class="feature__media">
    <Figure
      src={data.heroImage}
      alt={data.heroAlt}
      frame={layout === 'lead' ? 'browser' : 'browser'}
      url={displayUrl}
      ratio={layout === 'lead' ? '16 / 9' : '4 / 3'}
      priority={index === 0}
    />
  </div>

  <div class="feature__body">
    <header class="feature__head">
      <p class="feature__index mono">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <span class="feature__status">{data.status}</span>
      </p>
      <h3 class="feature__title">
        <a href={href}>{data.title}</a>
      </h3>
      <p class="feature__tagline">{data.tagline}</p>
    </header>

    <p class="feature__summary">{data.summary}</p>

    {
      data.metrics.length > 0 && (
        <ul class="feature__metrics">
          {data.metrics.map((metric) => (
            <li>
              <span class="feature__metric-value">{metric.value}</span>
              <span class="feature__metric-label">{metric.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    <footer class="feature__foot">
      <ul class="feature__stack mono">
        {data.stack.map((tech) => <li>{tech}</li>)}
      </ul>
      <p class="feature__cta">
        <span>Read case study</span>
        <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
          <path
            d="M2 7h10M12 7l-4-4M12 7l-4 4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </p>
    </footer>
  </div>
</article>

<style>
  .feature {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  /* --- Ambient tint -------------------------------------------
     A very low-opacity wash keyed to the project, bleeding past the
     card edges so the surrounding page shifts rather than the card. */
  .feature__glow {
    position: absolute;
    inset: -18% -14%;
    z-index: -1;
    background: radial-gradient(
      52% 58% at 50% 42%,
      hsl(var(--atmosphere) / 11%) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }

  .feature:hover .feature__glow,
  .feature:focus-within .feature__glow {
    opacity: 1;
  }

  /* --- Media --------------------------------------------------- */
  .feature__media {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .feature:hover .feature__media {
    transform: translateY(-6px);
  }

  .feature__media :global(.figure__frame) {
    transition:
      border-color var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out);
  }

  .feature:hover .feature__media :global(.figure__frame) {
    border-color: hsl(var(--atmosphere) / 32%);
    box-shadow: var(--shadow-lg);
  }

  .feature__media :global(.figure__well img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .feature:hover .feature__media :global(.figure__well img) {
    transform: scale(1.02);
  }

  /* --- Body ---------------------------------------------------- */
  .feature__body {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .feature__index {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-faint);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--fs-micro);
  }

  .feature__status {
    padding: 0.15rem 0.55rem;
    color: hsl(var(--atmosphere) / 95%);
    background: hsl(var(--atmosphere) / 12%);
    border-radius: var(--radius-full);
  }

  .feature__title {
    margin-top: var(--space-3);
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
  }

  /* One anchor per card, stretched across the whole article. */
  .feature__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .feature__tagline {
    margin-top: var(--space-2);
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .feature__summary {
    max-width: 44rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  /* --- Metrics -------------------------------------------------- */
  .feature__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-top: var(--space-2);
  }

  .feature__metrics li {
    display: grid;
    gap: 2px;
  }

  .feature__metric-value {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    color: var(--text);
  }

  .feature__metric-label {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  /* --- Footer --------------------------------------------------- */
  .feature__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .feature__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    color: var(--text-faint);
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
  }

  .feature__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: color var(--dur) var(--ease-out);
  }

  .feature:hover .feature__cta {
    color: var(--text);
  }

  .feature__cta svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .feature:hover .feature__cta svg {
    transform: translateX(3px);
  }

  /* --- Layouts -------------------------------------------------- */
  @media (min-width: 62rem) {
    .feature[data-layout='lead'] {
      gap: var(--space-8);
    }

    .feature[data-layout='lead'] .feature__body {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      column-gap: var(--space-9);
      align-items: start;
    }

    .feature[data-layout='lead'] .feature__head {
      grid-row: span 3;
    }

    .feature[data-layout='lead'] .feature__title {
      font-size: var(--fs-h1);
    }

    .feature[data-layout='lead'] .feature__foot {
      grid-column: 2;
    }

    .feature[data-layout='split'],
    .feature[data-layout='split-reverse'] {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-9);
    }

    .feature[data-layout='split-reverse'] .feature__media {
      order: 2;
    }

    .feature[data-layout='split-reverse'] .feature__body {
      order: 1;
    }
  }

  @media (max-width: 61.99rem) {
    .feature__metrics {
      gap: var(--space-5);
    }
  }
</style>
