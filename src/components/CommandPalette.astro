---
/**
 * ⌘K / Ctrl+K command palette: jump to any page, project, or profile, or
 * copy the email address. Built on the native <dialog>, so focus trapping
 * and Escape come from the browser.
 */
import { getCollection } from 'astro:content';
import { nav, navCta, site, socials } from '../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

interface Command {
  group: string;
  label: string;
  hint?: string;
  href?: string;
  action?: 'copy-email';
  external?: boolean;
}

const commands: Command[] = [
  { group: 'Pages', label: 'Home', href: '/' },
  ...[...nav, navCta].map((item) => ({ group: 'Pages', label: item.label, href: item.href })),
  ...projects.map((project) => ({
    group: 'Projects',
    label: project.data.title,
    hint: project.data.tagline,
    href: `/projects/${project.id}`,
  })),
  ...socials.map((social) => ({
    group: 'Elsewhere',
    label: social.label,
    hint: social.handle,
    href: social.href,
    external: social.href.startsWith('http'),
  })),
  { group: 'Actions', label: 'Copy email address', hint: site.email, action: 'copy-email' },
];
const groups = [...new Set(commands.map((command) => command.group))];
---

<dialog class="palette" aria-label="Command palette" data-palette>
  <div class="palette__search">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="m14 14 3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
      ></path>
    </svg>
    <input
      type="text"
      placeholder="Jump to a page, project, or profile…"
      aria-label="Search commands"
      aria-controls="palette-list"
      autocomplete="off"
      spellcheck="false"
      data-palette-input
    />
    <kbd>esc</kbd>
  </div>

  <ul class="palette__list" id="palette-list" role="listbox" data-palette-list>
    {
      groups.map((group) => (
        <li class="palette__group" role="presentation" data-group={group}>
          <p class="palette__group-label mono" aria-hidden="true">
            {group}
          </p>
          <ul role="presentation">
            {commands
              .filter((command) => command.group === group)
              .map((command) => (
                <li role="presentation">
                  <a
                    class="palette__item"
                    role="option"
                    aria-selected="false"
                    href={command.href ?? '#'}
                    target={command.external ? '_blank' : undefined}
                    rel={command.external ? 'noopener' : undefined}
                    data-action={command.action}
                    data-email={command.action === 'copy-email' ? site.email : undefined}
                    data-search={`${command.label} ${command.hint ?? ''} ${group}`.toLowerCase()}
                  >
                    <span class="palette__label">{command.label}</span>
                    {command.hint && <span class="palette__hint">{command.hint}</span>}
                    <span class="palette__arrow" aria-hidden="true">
                      {command.external ? '↗' : command.action ? '⧉' : '→'}
                    </span>
                  </a>
                </li>
              ))}
          </ul>
        </li>
      ))
    }
  </ul>
  <p class="palette__empty" hidden data-palette-empty>No matches.</p>

  <footer class="palette__foot mono" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>⌘</kbd><kbd>K</kbd> toggle</span>
  </footer>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');
  const input = document.querySelector<HTMLInputElement>('[data-palette-input]');
  const empty = document.querySelector<HTMLElement>('[data-palette-empty]');

  if (dialog && input && empty) {
    const items = [...dialog.querySelectorAll<HTMLAnchorElement>('.palette__item')];
    const groups = [...dialog.querySelectorAll<HTMLElement>('.palette__group')];
    let active = 0;

    const visible = () => items.filter((item) => !item.closest('li')!.hidden);

    const setActive = (index: number) => {
      const list = visible();
      if (!list.length) return;
      active = (index + list.length) % list.length;
      list.forEach((item, i) => item.setAttribute('aria-selected', String(i === active)));
      list[active]!.scrollIntoView({ block: 'nearest' });
    };

    const filter = () => {
      const query = input.value.trim().toLowerCase();
      for (const item of items) {
        item.closest('li')!.hidden = !!query && !item.dataset.search!.includes(query);
      }
      for (const group of groups) {
        group.hidden = !group.querySelector(':scope > ul > li:not([hidden])');
      }
      empty.hidden = visible().length > 0;
      setActive(0);
    };

    const open = () => {
      if (dialog.open) return;
      input.value = '';
      filter();
      dialog.showModal();
      input.focus();
    };

    const run = async (item: HTMLAnchorElement) => {
      if (item.dataset.action === 'copy-email') {
        await navigator.clipboard?.writeText(item.dataset.email ?? '');
        const label = item.querySelector('.palette__label')!;
        const original = label.textContent;
        label.textContent = 'Copied to clipboard';
        setTimeout(() => {
          label.textContent = original;
          dialog.close();
        }, 700);
        return;
      }
      dialog.close();
      if (item.target === '_blank') window.open(item.href, '_blank', 'noopener');
      else window.location.href = item.href;
    };

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        dialog.open ? dialog.close() : open();
      }
    });

    document
      .querySelectorAll('[data-palette-open]')
      .forEach((button) => button.addEventListener('click', open));

    input.addEventListener('input', filter);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(active - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const item = visible()[active];
        if (item) run(item);
      }
    });

    for (const item of items) {
      item.addEventListener('click', (event) => {
        event.preventDefault();
        run(item);
      });
      item.addEventListener('pointermove', () => setActive(visible().indexOf(item)));
    }

    // Clicking the backdrop (outside the panel) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .palette {
    width: min(38rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    overflow: hidden;
    color: var(--text);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 12%, transparent),
      0 40px 80px -30px rgb(44 38 37 / 45%);
    backdrop-filter: blur(16px);
  }

  .palette[open] {
    display: flex;
    flex-direction: column;
    animation: palette-in 180ms var(--ease-out);
  }

  .palette::backdrop {
    background: rgb(44 38 37 / 28%);
    backdrop-filter: blur(3px);
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }

  .palette__search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .palette__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--text);
    font-size: var(--fs-body);
    outline: none;
  }

  kbd {
    display: inline-grid;
    place-items: center;
    min-width: 1.5rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--bg);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    line-height: 1.5;
  }

  .palette__list {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-2);
  }

  .palette__group + .palette__group {
    margin-top: var(--space-2);
  }

  .palette__group-label {
    padding: var(--space-2) var(--space-3) var(--space-1);
    color: var(--text-faint);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .palette__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0.6rem var(--space-3);
    border-radius: 8px;
    color: var(--text-secondary);
    font-size: var(--fs-sm);
  }

  .palette__item[aria-selected='true'] {
    color: var(--text);
    background: var(--accent-dim);
  }

  .palette__label {
    flex-shrink: 0;
    font-weight: 500;
  }

  .palette__hint {
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .palette__arrow {
    margin-left: auto;
    color: var(--accent);
    opacity: 0;
  }

  .palette__item[aria-selected='true'] .palette__arrow {
    opacity: 1;
  }

  .palette__empty {
    padding: var(--space-6);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    text-align: center;
  }

  .palette__foot {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: var(--fs-micro);
  }

  .palette__foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .palette[open] {
      animation: none;
    }
  }
</style>
