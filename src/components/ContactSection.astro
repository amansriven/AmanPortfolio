---
import ContactForm from './ContactForm.svelte';
import SocialIcon from './SocialIcon.astro';
import { site, socials } from '../lib/site';

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

/* Without the key the form can never pass the server's Turnstile check, so a
   production build missing it fails here and the last good deploy stays live.
   (It went missing once when deploys moved from GitHub Actions to Workers
   Builds, and every message was rejected for hours before anyone noticed.) */
if (import.meta.env.PROD && !siteKey) {
  throw new Error(
    "PUBLIC_TURNSTILE_SITE_KEY is not set for this build. The contact form would reject every message. Add it under the Worker's Settings → Build → Variables and secrets.",
  );
}
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<section
  class:list={['section', 'contact', { standalone }]}
  id="contact"
  aria-label={standalone ? 'Contact details' : undefined}
  aria-labelledby={standalone ? undefined : 'contact-heading'}
>
  <div class="shell">
    <div class="contact__grid">
      <div class="contact__intro" data-reveal>
        <p class="eyebrow">Find me elsewhere</p>
        {
          !standalone && (
            <h2 class="contact__heading" id="contact-heading">
              Let&rsquo;s build something.
            </h2>
          )
        }
        <p class="contact__body">
          Working on an interesting engineering problem, hiring for one, or want to argue about
          whether the model should be making that decision? I read everything that comes through
          here.
        </p>

        <ul class="contact__direct">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener"
                >
                  <span class="social-circle" data-brand={social.label.toLowerCase()}>
                    <SocialIcon label={social.label} />
                  </span>
                  <span class="mono contact__direct-label">{social.label}</span>
                  <span class="contact__direct-value">{social.handle}</span>
                </a>
                {social.label === 'Email' && (
                  <button class="copy" type="button" data-copy={site.email}>
                    <span data-copy-label>Copy</span>
                  </button>
                )}
              </li>
            ))
          }
          <li>
            <a href={site.phone.href}>
              <span class="social-circle" data-brand="phone">
                <SocialIcon label="Phone" />
              </span>
              <span class="mono contact__direct-label">Phone</span>
              <span class="contact__direct-value">{site.phone.display}</span>
            </a>
          </li>
        </ul>
      </div>

      <p class="visually-hidden" aria-live="polite" data-copy-status></p>

      <div class="contact__form spotlight" data-reveal>
        <ContactForm
          client:visible
          siteKey={siteKey}
          email={site.email}
          phone={site.phone.display}
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { shortcut } from '../lib/platform';

  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = button.querySelector<HTMLElement>('[data-copy-label]')!;
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        label.textContent = 'Copied';
        button.classList.add('is-copied');
        if (status) status.textContent = 'Email address copied to clipboard.';
      } catch {
        // Clipboard access refused (permissions, an embedded browser): select
        // the address so the shortcut the button names actually copies it.
        const value = button.closest('li')?.querySelector('.contact__direct-value');
        if (value) window.getSelection()?.selectAllChildren(value);
        label.textContent = `Press ${shortcut('C')}`;
        if (status) status.textContent = `Email address selected. Press ${shortcut('C')} to copy.`;
      }
      clearTimeout(timer);
      timer = setTimeout(() => {
        label.textContent = 'Copy';
        button.classList.remove('is-copied');
      }, 1800);
    });
  }
</script>

<style>
  .standalone {
    padding-top: 0;
  }

  .contact {
    position: relative;
  }

  .contact:not(.standalone)::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--border);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .contact__intro {
    display: grid;
    /* Explicit, shrinkable column: the implicit one sizes to its widest
       child, the one-line email row, and spilled out at 320px. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-content: start;
  }

  .contact__heading {
    font-size: var(--fs-h1);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
  }

  .contact__body {
    max-width: 34rem;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .contact__direct {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-top: var(--space-4);
  }

  .contact__direct a {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .contact__direct li:last-child a {
    border-bottom: 1px solid var(--border);
  }

  .contact__direct a:hover {
    color: var(--text);
    border-top-color: var(--border-bright);
  }

  .contact__direct-label {
    flex: 0 0 5rem;
    color: var(--text-faint);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .contact__direct li {
    position: relative;
  }

  /* Sits over the right end of the email row, outside the link. */
  .copy {
    position: absolute;
    top: 50%;
    right: 0;
    min-width: 4.75rem;
    min-height: 32px;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    transform: translateY(-50%);
    transition:
      color var(--dur-fast),
      background var(--dur-fast),
      border-color var(--dur-fast);
  }

  .copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .copy.is-copied {
    color: var(--on-accent);
    background: var(--success);
    border-color: var(--success);
  }

  .contact__direct-value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The copy button floats over the end of the email row; keep the address
     out from under it. */
  .contact__direct li:has(.copy) a {
    padding-right: calc(4.75rem + var(--space-3));
  }

  .contact__form {
    padding: var(--space-7);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 61.99rem) {
    .contact__grid {
      /* minmax(0, …): a bare 1fr can't shrink below its content, and the
         one-line email row would push a 320px screen sideways. */
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    .contact__form {
      padding: var(--space-6) var(--space-5);
    }
  }

  @media (max-width: 30rem) {
    .contact__form {
      padding: var(--space-5) var(--space-4);
    }

    /* On a phone the label column left ~110px for the value, so the email
       was cut off. Each row's icon already names it; the label stays in the
       accessibility tree, so links still read "GitHub amansriven". */
    .contact__direct-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
