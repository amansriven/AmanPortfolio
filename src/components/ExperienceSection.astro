---
import { experience } from '../lib/experience';
import SectionHead from './SectionHead.astro';
import CompanyLogo from './CompanyLogo.astro';
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<section
  class:list={['section', 'experience', { standalone }]}
  id="experience"
  aria-label={standalone ? 'Experience details' : undefined}
  aria-labelledby={standalone ? undefined : 'experience-heading'}
>
  <div class="shell">
    {
      !standalone && (
        <SectionHead
          index="02"
          title="Experience"
          meta="Platform · Backend · Quant · Research"
          id="experience-heading"
        />
      )
    }

    <ol class="timeline">
      {
        experience.map((role) => (
          <li class="entry spotlight" data-reveal>
            <CompanyLogo role={role} />

            <div class="entry__body">
              <div class="entry__head">
                <div>
                  <h3 class="entry__org">{role.org}</h3>
                  <p class="entry__role">{role.role}</p>
                </div>
                <p class="entry__when mono">
                  <span>{role.period}</span>
                  <span class="entry__where">{role.location}</span>
                </p>
              </div>

              <p class="entry__summary">{role.summary}</p>

              {role.metrics && (
                <ul class="entry__metrics">
                  {role.metrics.map((metric) => (
                    <li>
                      <span class="entry__metric-value mono">{metric.value}</span>
                      <span class="entry__metric-label">{metric.label}</span>
                    </li>
                  ))}
                </ul>
              )}

              <ul class="entry__stack mono" aria-label="Tools">
                {role.stack.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .standalone {
    padding-top: 0;
  }

  .timeline {
    display: grid;
  }

  .entry {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
    transition: border-color var(--dur) var(--ease-out);
  }

  .entry:last-child {
    border-bottom: 1px solid var(--border);
  }

  .entry:hover {
    border-top-color: var(--border-strong);
  }

  .entry__body {
    display: grid;
    gap: var(--space-4);
    max-width: 50rem;
  }

  .entry__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
  }

  .entry__org {
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }

  .entry__role {
    margin-top: 2px;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  .entry__when {
    display: grid;
    gap: 2px;
    text-align: right;
    color: var(--text-muted);
    font-size: var(--fs-micro);
    letter-spacing: 0.05em;
  }

  .entry__where {
    color: var(--text-faint);
  }

  .entry__summary {
    color: var(--text-secondary);
    font-size: var(--fs-body);
    text-wrap: pretty;
  }

  /* --- Metrics ------------------------------------------------- */
  /* Equal columns, so the boxes line up from one role to the next. */
  .entry__metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .entry__metrics li {
    display: grid;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--dur) var(--ease-out);
  }

  .entry:hover .entry__metrics li {
    border-color: var(--border-strong);
  }

  .entry__metric-value {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--accent);
  }

  .entry__metric-label {
    font-size: var(--fs-micro);
    color: var(--text-muted);
    line-height: 1.4;
  }

  .entry__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: var(--fs-micro);
  }

  .entry__stack li {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--surface);
    color: var(--text-secondary);
  }

  @media (max-width: 47.99rem) {
    .entry {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--space-4);
      padding-block: var(--space-6);
    }

    .entry :global(.logo) {
      --size: 2.5rem !important;
    }

    .entry__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .entry__when {
      text-align: left;
      grid-auto-flow: column;
      gap: var(--space-3);
    }

    .entry__metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
