---
import { Image } from 'astro:assets';
import type { Experience } from '../lib/experience';

interface Props {
  role: Pick<Experience, 'org' | 'logo'>;
  /** Rendered edge length, in rem. */
  size?: number;
}
const { role, size = 3 } = Astro.props;

/* "Sinn Fund, Aggie Investment Club" -> "SF": initials of the name before
   any comma, used when there is no logo file. */
const monogram = role.org
  .split(',')[0]!
  .split(/\s+/)
  .filter(Boolean)
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<span class="logo" style={`--size: ${size}rem`} aria-hidden="true">
  {
    role.logo ? (
      <Image src={role.logo} alt="" width={Math.round(size * 32)} densities={[1, 2]} />
    ) : (
      <span class="logo__monogram">{monogram}</span>
    )
  }
</span>

<style>
  .logo {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: var(--size);
    height: var(--size);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
  }

  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo__monogram {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--on-accent);
    background: var(--accent-fill);
    font: italic 400 calc(var(--size) * 0.4) var(--font-display);
    letter-spacing: -0.04em;
  }
</style>
