---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="page-intro shell">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="page-intro__description">{description}</p>
</header>
<style>
  .page-intro {
    padding-top: 4rem;
    padding-bottom: 2.75rem;
  }
  h1 {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.04em;
  }
  .eyebrow {
    color: var(--accent);
  }
  .page-intro__description {
    margin-top: 1rem;
    max-width: 38rem;
    color: var(--text-secondary);
    font-size: var(--fs-lead);
  }
  @media (max-width: 47.99rem) {
    .page-intro {
      padding-top: 2.5rem;
      padding-bottom: 2rem;
    }
  }
</style>
