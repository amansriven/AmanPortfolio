---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait/aman.jpg';
import { site, socials } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;

/* Split for a staggered entrance; each line animates as a unit. */
const nameLines = ['Aman', 'Sriven'];

const facts = ['CS @ Texas A&M ’28', 'Previously SWE @ Humana & JAGGAER', site.location];

/* One glyph per social, keyed by label. Kept inline so the hero stays a single
   request with no icon font. */
const glyphs: Record<(typeof socials)[number]['label'], string> = {
  GitHub:
    'M8 .8a7.2 7.2 0 0 0-2.28 14.03c.36.07.49-.16.49-.35v-1.23c-2 .43-2.42-.97-2.42-.97-.33-.83-.8-1.05-.8-1.05-.66-.45.05-.44.05-.44.72.05 1.1.74 1.1.74.65 1.1 1.7.79 2.11.6.07-.47.25-.79.46-.97-1.6-.18-3.28-.8-3.28-3.56 0-.79.28-1.43.74-1.93-.07-.18-.32-.92.07-1.91 0 0 .6-.19 1.98.74a6.9 6.9 0 0 1 3.6 0c1.37-.93 1.98-.74 1.98-.74.39.99.14 1.73.07 1.91.46.5.74 1.14.74 1.93 0 2.77-1.69 3.38-3.3 3.56.26.22.49.66.49 1.33v1.98c0 .19.13.42.5.35A7.2 7.2 0 0 0 8 .8Z',
  LinkedIn:
    'M3.6 6.2H1.4v7.6h2.2ZM2.5 2.2a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6ZM14.6 9.1c0-2.3-1.2-3.1-2.8-3.1-1.2 0-1.9.6-2.2 1.1V6.2H7.4v7.6h2.2V9.7c0-1 .3-1.8 1.4-1.8s1.3.9 1.3 1.8v4.1h2.3Z',
  Email: 'M1.5 3.5h13v9h-13Zm0 0 6.5 5 6.5-5',
};
---

<section class="hero">
  <div class="hero__atmosphere" aria-hidden="true"></div>
  <div class="rules" aria-hidden="true">
    <span style="left: 18%"></span>
    <span style="left: 50%"></span>
    <span style="left: 82%"></span>
  </div>

  <div class="shell shell--wide hero__inner">
    <div class="hero__identity">
      <Image
        class="hero__portrait"
        src={portrait}
        alt="Aman Sriven"
        widths={[64, 128, 192]}
        sizes="60px"
        loading="eager"
      />
      <p class="eyebrow hero__eyebrow">Software Engineer</p>
    </div>

    <h1 class="hero__name">
      {
        nameLines.map((line, i) => (
          <span class="hero__line">
            <span class="hero__line-inner" style={`--delay: ${120 + i * 90}ms`}>
              {line}
            </span>
          </span>
        ))
      }
    </h1>

    <div class="hero__body">
      <p class="hero__lead">
        I build infrastructure that carries real traffic and products that reach real people — AI
        gateways and data pipelines on one end, shipped consumer software on the other.
      </p>

      <div class="hero__actions">
        <a class="button button--primary" href="#work">
          View work
          <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
            <path
              d="M7 2v10M7 12l-4-4M7 12l4-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="button" href="#contact">
          Get in touch
          <svg viewBox="0 0 14 14" width="11" height="11" aria-hidden="true">
            <path
              d="M2 7h10M12 7l-4-4M12 7l-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero__meta">
      <ul class="hero__facts">
        {facts.map((fact) => <li class="mono">{fact}</li>)}
      </ul>

      <ul class="hero__socials" aria-label="Elsewhere">
        {
          socials.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
                aria-label={`${social.label}: ${social.handle}`}
              >
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                  <path
                    d={glyphs[social.label]}
                    fill={social.label === 'Email' ? 'none' : 'currentColor'}
                    stroke={social.label === 'Email' ? 'currentColor' : undefined}
                    stroke-width={social.label === 'Email' ? '1.3' : undefined}
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="mono">{social.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- A table of contents for the work below: the point of the page, stated up front. -->
  <div class="shell shell--wide">
    <ol class="hero__index" aria-label="Selected work">
      {
        projects.map((project, i) => (
          <li>
            <a href={`/projects/${project.id}`} style={`--atmosphere: ${project.data.accent}`}>
              <span class="hero__index-num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="hero__index-title">{project.data.title}</span>
              <span class="hero__index-year mono">{project.data.year}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-9);
    min-height: 100svh;
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: var(--space-8);
    overflow: hidden;
  }

  /* A single, very low-contrast wash. No blobs, no particles. */
  .hero__atmosphere {
    position: absolute;
    inset: -20% -10% auto;
    height: 90%;
    background: radial-gradient(60% 55% at 72% 8%, hsl(var(--atmosphere) / 9%) 0%, transparent 68%);
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
  }

  .hero__identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .hero__identity :global(.hero__portrait) {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    /* The face sits high in the frame; pull the crop up to centre it. */
    object-position: center 28%;
    border: 1px solid var(--border-strong);
    filter: saturate(0.94);
  }

  .hero__eyebrow {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-3);
  }

  .hero__eyebrow::after {
    content: '';
    flex: 1;
    max-width: 6rem;
    height: 1px;
    background: var(--border-strong);
  }

  /* --- Name -------------------------------------------------- */
  .hero__name {
    font-size: var(--fs-display);
    font-weight: 500;
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
    margin-block: var(--space-2) var(--space-4);
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em;
  }

  .hero__line-inner {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__line-inner {
      transform: translateY(105%);
      animation: hero-rise 1s var(--ease-out) forwards;
      animation-delay: var(--delay);
    }
  }

  @keyframes hero-rise {
    to {
      transform: none;
    }
  }

  /* --- Lead + actions ---------------------------------------- */
  .hero__body {
    display: grid;
    gap: var(--space-6);
    max-width: 46rem;
  }

  .hero__lead {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.7rem 1.25rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .button:hover {
    border-color: var(--border-bright);
    background: var(--surface-raised);
  }

  .button--primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg-deep);
  }

  .button--primary:hover {
    background: #fff;
    border-color: #fff;
    color: var(--bg-deep);
  }

  .button svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .button--primary:hover svg {
    transform: translateY(2px);
  }

  .button:not(.button--primary):hover svg {
    transform: translateX(3px);
  }

  /* --- Fact rail + socials ----------------------------------- */
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-2);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    color: var(--text-muted);
  }

  .hero__facts li {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .hero__facts li:not(:last-child)::after {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-faint);
  }

  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .hero__socials a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
    transition: color var(--dur) var(--ease-out);
  }

  .hero__socials a:hover {
    color: var(--text);
  }

  .hero__socials svg {
    flex-shrink: 0;
    color: var(--text-faint);
    transition: color var(--dur) var(--ease-out);
  }

  .hero__socials a:hover svg {
    color: var(--accent);
  }

  /* --- Work index -------------------------------------------- */
  .hero__index {
    border-top: 1px solid var(--border);
  }

  .hero__index a {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    transition:
      color var(--dur) var(--ease-out),
      padding-left var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .hero__index a:hover {
    color: var(--text);
    padding-left: var(--space-4);
    background: linear-gradient(90deg, hsl(var(--atmosphere) / 7%), transparent 55%);
  }

  .hero__index-num {
    color: var(--text-faint);
    transition: color var(--dur) var(--ease-out);
  }

  .hero__index a:hover .hero__index-num {
    color: hsl(var(--atmosphere) / 90%);
  }

  .hero__index-title {
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .hero__index-year {
    color: var(--text-faint);
  }

  @media (max-width: 47.99rem) {
    .hero {
      min-height: auto;
      gap: var(--space-8);
      padding-top: calc(var(--header-height) + var(--space-9));
      padding-bottom: var(--space-6);
    }

    .hero__index {
      display: none;
    }

    .hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }

    .hero__facts {
      flex-direction: column;
      gap: var(--space-1);
    }

    .hero__facts li:not(:last-child)::after {
      display: none;
    }

    .hero__socials {
      gap: var(--space-2) var(--space-4);
    }
  }
</style>
