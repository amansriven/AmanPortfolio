---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait/aman.jpg';
---

<section class="hero shell" aria-labelledby="intro-heading" data-hero>
  <div class="hero__backdrop" aria-hidden="true" data-hero-backdrop></div>
  <div class="hero__copy">
    <!-- Full text is in the markup; the script retypes it when motion is allowed. -->
    <p class="eyebrow hero__typed">
      <span data-typed>Engineer. Student. Builder.</span><span
        class="hero__caret"
        aria-hidden="true"></span>
    </p>
    <h1 id="intro-heading">Aman <span>Sriven.</span></h1>
    <p class="hero__lead">Thoughtful software.<br />Real-world impact.</p>
    <p class="hero__description">
      I build reliable, data-backed software, from AI infrastructure at Humana and supplier services
      at JAGGAER to apps people use every day. Computer science at Texas A&amp;M.
    </p>
    <div class="hero__actions">
      <a class="button-primary" href="/projects"
        >Explore my work <span aria-hidden="true">→</span></a
      >
      <a class="button-secondary" href="/experience"
        >My experience <span aria-hidden="true">→</span></a
      >
      <a class="text-link" href="/about">A little about me <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <figure class="hero__portrait">
    <span class="hero__grid" aria-hidden="true"></span>
    <div class="hero__frame">
      <div class="hero__photo">
        <Image
          src={portrait}
          alt="Aman Sriven"
          widths={[320, 480, 720]}
          sizes="(max-width: 47.99rem) 16rem, 22rem"
          loading="eager"
        />
      </div>
    </div>
    <span class="hero__corner hero__corner--tl" aria-hidden="true"></span>
    <span class="hero__corner hero__corner--tr" aria-hidden="true"></span>
    <span class="hero__corner hero__corner--bl" aria-hidden="true"></span>
    <span class="hero__corner hero__corner--br" aria-hidden="true"></span>
  </figure>
</section>
<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Typewriter eyebrow. The text is already in the page, so no-JS and
  // reduced-motion visitors simply see it; screen readers get it once.
  const typed = document.querySelector<HTMLElement>('[data-typed]');
  if (typed && !reduceMotion) {
    const text = typed.textContent ?? '';
    // Screen readers get the whole line once, from a hidden copy, rather than
    // the animation one letter at a time. (aria-label isn't allowed on a <p>.)
    const label = document.createElement('span');
    label.className = 'visually-hidden';
    label.textContent = text;
    typed.before(label);
    typed.setAttribute('aria-hidden', 'true');
    typed.textContent = '';
    let i = 0;
    const tick = () => {
      typed.textContent = text.slice(0, ++i);
      if (i < text.length) setTimeout(tick, text[i - 1] === '.' ? 260 : 55);
    };
    setTimeout(tick, 350);
  }

  // Dot-grid spotlight that follows the pointer across the hero.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const backdrop = document.querySelector<HTMLElement>('[data-hero-backdrop]');
  if (hero && backdrop && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
    hero.addEventListener('pointermove', (event) => {
      const rect = backdrop.getBoundingClientRect();
      backdrop.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      backdrop.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    });
    hero.addEventListener('pointerleave', () => {
      backdrop.style.removeProperty('--mx');
      backdrop.style.removeProperty('--my');
    });
  }
</script>
<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(17rem, 30vw, 22rem);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding-top: 4.5rem;
    padding-bottom: var(--section-space);
  }
  .eyebrow {
    color: var(--accent);
  }

  /* --- Motion ------------------------------------------------------ */
  /* Registered so the spotlight position can transition smoothly. */
  @property --mx {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 78%;
  }
  @property --my {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 45%;
  }
  /* Full-bleed dot grid behind the hero, lit by a spotlight that rests on
     the portrait and follows the pointer. */
  .hero__backdrop {
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(
      color-mix(in srgb, var(--accent) 38%, transparent) 1px,
      transparent 1.6px
    );
    background-size: 22px 22px;
    background-position: center;
    mask-image: radial-gradient(
      circle 26rem at var(--mx) var(--my),
      #000 0%,
      rgb(0 0 0 / 35%) 45%,
      transparent 75%
    );
    transition:
      --mx 0.6s var(--ease-out),
      --my 0.6s var(--ease-out);
    animation: hero-fade 1.2s var(--ease-out) both;
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }
  /* Terminal-style caret after the typed eyebrow. */
  .hero__typed {
    display: flex;
    align-items: center;
    min-height: 1.2em;
  }
  .hero__caret {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 0.3em;
    background: var(--accent);
    animation: hero-caret 1s steps(1) infinite;
  }
  @keyframes hero-caret {
    50% {
      opacity: 0;
    }
  }
  h1 {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 5.2vw, 5.3rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }
  h1 span {
    color: var(--accent);
  }
  .hero__lead {
    margin-top: 1.5rem;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
  .hero__description {
    margin-top: 1rem;
    max-width: 31rem;
    font-size: var(--fs-sm);
    line-height: 1.8;
    color: var(--text-secondary);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  /* --- Portrait ----------------------------------------------------
     A rounded photo in a thin frame with a gradient edge, sitting on a soft
     accent glow and a dot grid, with viewfinder brackets at the corners. */
  .hero__portrait {
    --corner-gap: -0.7rem;
    position: relative;
    isolation: isolate;
    margin: 0;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  /* Soft accent glow behind the frame. */
  .hero__portrait::before {
    content: '';
    position: absolute;
    inset: 12% 8%;
    z-index: -2;
    border-radius: 50%;
    background: var(--accent);
    filter: blur(48px);
    opacity: 0.18;
    transition: opacity var(--dur-slow) var(--ease-out);
  }
  /* Dot grid, offset down and to the right, fading out. */
  .hero__grid {
    position: absolute;
    inset: 1.5rem -1.5rem -1.5rem 1.5rem;
    z-index: -1;
    border-radius: 22px;
    background-image: radial-gradient(
      color-mix(in srgb, var(--accent) 45%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 12px 12px;
    mask-image: linear-gradient(135deg, transparent 20%, #000 55%, transparent 95%);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  /* Gradient edge: a 1px padding box painted with the gradient. */
  .hero__frame {
    padding: 1px;
    border-radius: 20px;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--accent) 70%, transparent),
      var(--border) 35%,
      var(--border) 65%,
      color-mix(in srgb, var(--accent) 45%, transparent)
    );
    box-shadow:
      0 1px 2px rgb(var(--shadow-rgb) / 6%),
      0 24px 48px -28px rgb(var(--shadow-rgb) / 45%);
    transition: box-shadow var(--dur-slow) var(--ease-out);
  }
  .hero__photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 6px solid var(--surface);
    border-radius: 19px;
    background: var(--bg-deep);
  }
  /* Same crop as the About page: the whole photo, anchored near the top. */
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 13px;
    object-fit: cover;
    object-position: center 22%;
  }
  /* One scan line sweeps down the photo on load. */
  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 35%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--accent) 22%, transparent) 70%,
      color-mix(in srgb, #fff 55%, transparent) 99%,
      transparent
    );
    transform: translateY(-100%);
    animation: hero-scan 1.6s var(--ease-in-out) 0.5s 1 both;
    pointer-events: none;
  }
  @keyframes hero-scan {
    0% {
      transform: translateY(-100%);
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateY(300%);
      opacity: 0;
    }
  }
  /* Viewfinder brackets: they start wide and snap in, like a lens locking
     focus, then sit still. */
  .hero__corner {
    --out: -14px;
    position: absolute;
    animation: hero-lock 0.7s var(--ease-out) 0.35s backwards;
    width: 16px;
    height: 16px;
    border: 0 solid var(--accent);
    opacity: 0.55;
    transition:
      inset var(--dur-slow) var(--ease-out),
      opacity var(--dur-slow) var(--ease-out);
  }
  .hero__corner--tl {
    --from: translate(var(--out), var(--out));
    top: var(--corner-gap);
    left: var(--corner-gap);
    border-top-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 6px;
  }
  .hero__corner--tr {
    --from: translate(calc(-1 * var(--out)), var(--out));
    top: var(--corner-gap);
    right: var(--corner-gap);
    border-top-width: 2px;
    border-right-width: 2px;
    border-top-right-radius: 6px;
  }
  .hero__corner--bl {
    --from: translate(var(--out), calc(-1 * var(--out)));
    bottom: var(--corner-gap);
    left: var(--corner-gap);
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-bottom-left-radius: 6px;
  }
  .hero__corner--br {
    --from: translate(calc(-1 * var(--out)), calc(-1 * var(--out)));
    right: var(--corner-gap);
    bottom: var(--corner-gap);
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-bottom-right-radius: 6px;
  }
  @keyframes hero-lock {
    from {
      transform: var(--from);
      opacity: 0;
    }
  }
  /* Hover: lift, brackets widen, glow brightens. The photo itself stays put. */
  .hero__portrait:hover {
    --corner-gap: -1.1rem;
    transform: translateY(-6px);
  }
  .hero__portrait:hover::before {
    opacity: 0.32;
  }
  .hero__portrait:hover .hero__grid {
    transform: translate(6px, 6px);
  }
  .hero__portrait:hover .hero__frame {
    box-shadow:
      0 1px 2px rgb(var(--shadow-rgb) / 6%),
      0 32px 60px -28px rgb(var(--shadow-rgb) / 55%);
  }
  .hero__portrait:hover .hero__corner {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__backdrop,
    .hero__corner {
      animation: none;
    }
    .hero__photo::after {
      display: none;
    }
    .hero__caret {
      animation: none;
    }
    .hero__portrait:hover {
      --corner-gap: -0.7rem;
      transform: none;
    }
    .hero__portrait:hover .hero__grid {
      transform: none;
    }
  }
  @media (max-width: 47.99rem) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-top: 2.5rem;
    }
    .hero__portrait {
      width: min(16rem, 75vw);
    }
  }
</style>
