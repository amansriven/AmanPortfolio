---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';
import { paper } from '../lib/research';

/**
 * The paper as an object.
 *
 * Page one is rendered straight out of the PDF at build time, so the cover can
 * never drift from the file it links to. Two offset sheets sit behind it to
 * suggest the rest of the document; the whole stack straightens on hover.
 */
const cover = resolveImage('/media/research/page-1.png');
---

<a class="cover" href={paper.href} target="_blank" rel="noopener">
  <span class="cover__stack" aria-hidden="true">
    <span class="cover__sheet cover__sheet--back"></span>
    <span class="cover__sheet cover__sheet--mid"></span>
  </span>

  <span class="cover__page">
    {
      cover && (
        <Image
          src={cover}
          alt={`First page of ${paper.acronym}: ${paper.subtitle}`}
          widths={[384, 768]}
          sizes="(max-width: 62rem) 60vw, 24rem"
          format="webp"
          quality={70}
          loading="eager"
        />
      )
    }
    <span class="cover__sheen" aria-hidden="true"></span>
  </span>

  <span class="cover__badge mono">
    <span>PDF</span>
    <span class="cover__badge-sep" aria-hidden="true">·</span>
    <span>{paper.pages} pages</span>
    <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
      <path
        d="M3 9L9 3M9 3H4.5M9 3v4.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .cover {
    position: relative;
    display: block;
    width: 100%;
    max-width: 24rem;
    padding-bottom: var(--space-6);
  }

  .cover__stack,
  .cover__sheet {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cover__sheet {
    bottom: var(--space-6);
    background: #d8d9db;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .cover__sheet--back {
    transform: translate(14px, 12px) rotate(2.6deg);
    opacity: 0.35;
  }

  .cover__sheet--mid {
    transform: translate(7px, 6px) rotate(1.3deg);
    opacity: 0.6;
  }

  .cover__page {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow-lg);
    transform: rotate(-0.9deg);
    transition:
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out);
  }

  .cover__page :global(img) {
    display: block;
    width: 100%;
    height: auto;
    /* A bright white page in a near-black layout is a hole. Pulled down at
       rest, released on hover. */
    filter: brightness(0.88) contrast(1.04) saturate(0.9);
    transition: filter var(--dur-slow) var(--ease-out);
  }

  /* A raking highlight across the sheet, so it reads as paper under a light
     rather than as a flat screenshot. */
  .cover__sheen {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        105deg,
        rgb(255 255 255 / 22%) 0%,
        transparent 34%,
        transparent 68%,
        rgb(0 0 0 / 12%) 100%
      ),
      linear-gradient(to bottom, transparent 70%, rgb(10 11 12 / 22%) 100%);
    mix-blend-mode: overlay;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .cover:hover .cover__page,
  .cover:focus-visible .cover__page {
    transform: rotate(0deg) translateY(-6px);
    box-shadow: 0 48px 96px -36px rgb(0 0 0 / 85%);
  }

  .cover:hover .cover__page :global(img) {
    filter: brightness(1) contrast(1) saturate(1);
  }

  .cover:hover .cover__sheen {
    opacity: 0.4;
  }

  .cover:hover .cover__sheet--back {
    transform: translate(20px, 16px) rotate(3.4deg);
  }

  .cover:hover .cover__sheet--mid {
    transform: translate(11px, 9px) rotate(1.9deg);
  }

  /* --- Badge ---------------------------------------------------- */
  .cover__badge {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.3rem 0.8rem;
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .cover__badge-sep {
    color: var(--text-faint);
  }

  .cover:hover .cover__badge {
    color: var(--text);
    border-color: hsl(var(--atmosphere) / 55%);
  }

  .cover__badge svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .cover:hover .cover__badge svg {
    transform: translate(1px, -1px);
  }

  @media (max-width: 61.99rem) {
    .cover {
      max-width: 16rem;
      margin-inline: auto;
    }
  }
</style>
