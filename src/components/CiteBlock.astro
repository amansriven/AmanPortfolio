---
import { citation } from '../lib/research';

/**
 * BibTeX with a copy button. Twelve lines of inline script, no dependency,
 * and it degrades to a selectable code block if the script never runs.
 */
---

<div class="cite">
  <div class="cite__head">
    <p class="eyebrow">Cite</p>
    <button class="cite__copy mono" type="button" data-cite-copy data-label="Copy BibTeX">
      <svg viewBox="0 0 14 14" width="12" height="12" aria-hidden="true">
        <rect
          x="4.5"
          y="1.5"
          width="8"
          height="9"
          rx="1.6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"></rect>
        <path
          d="M9.5 12.5h-7a1 1 0 0 1-1-1v-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linecap="round"></path>
      </svg>
      <span data-cite-label>Copy BibTeX</span>
    </button>
  </div>

  <pre class="cite__code mono" data-cite-source>{citation}</pre>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-cite-copy]');
  const source = document.querySelector<HTMLElement>('[data-cite-source]');
  const label = button?.querySelector<HTMLElement>('[data-cite-label]');

  if (button && source && label) {
    let timer: ReturnType<typeof setTimeout>;
    const idle = button.dataset.label ?? 'Copy';

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(source.textContent ?? '');
        label.textContent = 'Copied';
        button.dataset.state = 'copied';
      } catch {
        // Clipboard access can be refused outright; say so rather than
        // claiming a copy that never happened.
        label.textContent = 'Select and copy';
        button.dataset.state = 'failed';
      }
      clearTimeout(timer);
      timer = setTimeout(() => {
        label.textContent = idle;
        delete button.dataset.state;
      }, 2400);
    });
  }
</script>

<style>
  .cite {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .cite__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .cite__copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.35rem 0.8rem;
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .cite__copy:hover {
    color: var(--text);
    border-color: hsl(var(--atmosphere) / 55%);
  }

  .cite__copy[data-state='copied'] {
    color: var(--success);
    border-color: color-mix(in srgb, var(--success) 45%, transparent);
  }

  .cite__copy[data-state='failed'] {
    color: var(--danger);
    border-color: color-mix(in srgb, var(--danger) 45%, transparent);
  }

  .cite__code {
    margin: 0;
    overflow-x: auto;
    font-size: var(--fs-micro);
    line-height: 1.8;
    color: var(--text-muted);
    white-space: pre;
    tab-size: 2;
  }
</style>
