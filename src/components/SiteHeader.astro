---
import { nav, navCta } from '../lib/site';
interface Props {
  isHome?: boolean;
}
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [{ label: 'Home', href: '/' }, ...nav, navCta];
---

<header class="header">
  <div class="header__inner shell">
    <a class="identity" href="/" aria-label="Aman Sriven — home">
      <span class="identity__mark" aria-hidden="true">as.</span>
      <span>Aman Sriven</span>
    </a>
    <div class="header__end">
    <nav aria-label="Primary">
      <ul class="navigation">
        {
          items.map((item) => {
            const active =
              item.href === '/'
                ? pathname === '/'
                : pathname === item.href || pathname.startsWith(`${item.href}/`);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={{ navigation__contact: item.href === '/contact' }}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <button class="palette-trigger" type="button" data-palette-open aria-label="Open command palette">
      <span>Search</span>
      <kbd>⌘K</kbd>
    </button>
    </div>
  </div>
  <!-- Fills as the page scrolls (CSS scroll-driven animation). -->
  <span class="header__progress" aria-hidden="true"></span>
</header>
<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-height);
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 100%;
  }
  .identity {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .identity__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding-right: 0.15rem;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 50%;
    font: italic 1.2rem var(--font-display);
    letter-spacing: -0.08em;
  }
  .header__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  nav {
    min-width: 0;
  }
  .palette-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 42px;
    padding: 0 0.5rem 0 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--fs-xs);
    transition:
      border-color var(--dur-fast),
      color var(--dur-fast),
      box-shadow var(--dur-fast);
  }
  .palette-trigger:hover {
    color: var(--text);
    border-color: var(--border-strong);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .palette-trigger kbd {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }
  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 55%, #fff));
    transform: scaleX(0);
    transform-origin: left;
  }
  @supports (animation-timeline: scroll()) {
    .header__progress {
      animation: header-progress linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes header-progress {
    to {
      transform: scaleX(1);
    }
  }
  .navigation {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .navigation a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.6rem 0.8rem;
    border-radius: 4px;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    white-space: nowrap;
    transition:
      background var(--dur-fast),
      color var(--dur-fast);
  }
  .navigation a:hover,
  .navigation a[aria-current] {
    color: var(--accent);
    background: var(--accent-dim);
  }
  .navigation a[aria-current] {
    font-weight: 600;
  }
  .navigation .navigation__contact {
    margin-left: 0.65rem;
    border: 1px solid var(--border-strong);
  }
  @media (max-width: 55.99rem) {
    .header__inner {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.45rem;
    }
    .identity {
      font-size: 0.85rem;
    }
    .identity__mark {
      width: 1.8rem;
      height: 1.8rem;
      font-size: 1rem;
    }
    nav {
      width: 100%;
      overflow-x: auto;
    }
    .navigation {
      width: max-content;
      min-width: 100%;
      padding: 3px;
    }
    .navigation a {
      min-height: 40px;
      padding: 0.5rem 0.65rem;
      font-size: 0.75rem;
    }
    .navigation .navigation__contact {
      margin-left: 0;
    }
    .header__end {
      width: 100%;
    }
    /* Touch screens have no ⌘K; the palette stays keyboard-only there. */
    .palette-trigger {
      display: none;
    }
  }
</style>
