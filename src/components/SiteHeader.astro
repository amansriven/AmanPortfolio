---
import Logo from './Logo.astro';
import MobileNav from './MobileNav.svelte';
import { nav, site } from '../lib/site';

interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;
---

<header class="header" data-header>
  <div class="header__inner shell shell--wide">
    <a class="brand" href="/" aria-current={isHome ? 'page' : undefined}>
      <Logo size={20} class="brand__mark" />
      <span class="brand__name">Aman Sriven</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a class="nav__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav__resume" href={site.resume} target="_blank" rel="noopener">
        Resume
        <svg viewBox="0 0 12 12" aria-hidden="true" width="10" height="10">
          <path
            d="M3 9L9 3M9 3H4.5M9 3v4.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </nav>

    <MobileNav client:idle items={[...nav]} resume={site.resume} />
  </div>
</header>

<script>
  // Adds a backdrop to the header once the page has scrolled past the hero lip.
  const header = document.querySelector('[data-header]');
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:0;height:1px;width:1px;';
    document.body.prepend(sentinel);
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-stuck', !entry!.isIntersecting),
      { threshold: 0 },
    ).observe(sentinel);
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-height);
    display: flex;
    align-items: center;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      backdrop-filter var(--dur) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .header.is-stuck {
    background-color: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: var(--border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  /* --- Brand ------------------------------------------------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
  }

  .brand :global(.brand__mark) {
    color: var(--accent);
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .brand:hover :global(.brand__mark) {
    transform: translateY(-1px);
    color: var(--accent-bright);
  }

  /* --- Desktop nav ------------------------------------------- */
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav__link {
    position: relative;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--text);
  }

  .nav__link:hover::after {
    transform: scaleX(1);
  }

  .nav__resume {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0.85rem;
    font-size: var(--fs-sm);
    color: var(--text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }

  .nav__resume:hover {
    border-color: var(--accent);
    background: var(--accent-dim);
  }

  .nav__resume svg {
    transition: transform var(--dur) var(--ease-out);
  }

  .nav__resume:hover svg {
    transform: translate(1px, -1px);
  }

  @media (max-width: 47.99rem) {
    .nav {
      display: none;
    }
  }
</style>
