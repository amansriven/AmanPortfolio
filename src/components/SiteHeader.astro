---
import { cleanPath, nav, navCta } from '../lib/site';
interface Props {
  isHome?: boolean;
}
const pathname = cleanPath(Astro.url.pathname);
const items = [{ label: 'Home', href: '/' }, ...nav, navCta];
---

<header class="header">
  <div class="header__inner shell">
    <a class="identity" href="/" aria-label="Aman Sriven — home">
      <span class="identity__mark" aria-hidden="true">as.</span>
      <span>Aman Sriven</span>
    </a>
    <div class="header__end">
      <nav aria-label="Primary">
        <ul class="navigation">
          {
            items.map((item) => {
              const active =
                item.href === '/'
                  ? pathname === '/'
                  : pathname === item.href || pathname.startsWith(`${item.href}/`);
              return (
                <li>
                  <a
                    href={item.href}
                    class:list={{ navigation__contact: item.href === '/contact' }}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <button
        class="palette-trigger"
        type="button"
        data-palette-open
        aria-label="Open command palette"
      >
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>
      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        data-theme-toggle
      >
        <svg
          class="theme-toggle__moon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
        >
          <path
            d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          class="theme-toggle__sun"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"
          ></circle>
          <path
            d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
  <!-- Fills as the page scrolls (CSS scroll-driven animation). -->
  <span class="header__progress" aria-hidden="true"></span>
</header>
<script>
  import { toggleTheme } from '../lib/theme';

  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    button?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  };
  label();
  button?.addEventListener('click', () => toggleTheme(button).then(label));
  // The ⌘K palette's "Toggle theme" command.
  document.addEventListener('theme:toggle', () => toggleTheme(button).then(label));
</script>
<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-height);
    background: color-mix(in srgb, var(--bg) 95%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 100%;
  }
  .identity {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .identity__mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding-right: 0.15rem;
    color: var(--on-accent);
    background: var(--accent-fill);
    border-radius: 50%;
    font: italic 1.2rem var(--font-display);
    letter-spacing: -0.08em;
  }
  .header__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  nav {
    min-width: 0;
  }
  /* Wide enough to read as a search field; the ⌘K hint sits at the right end. */
  .palette-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-width: 9.5rem;
    min-height: 42px;
    padding: 0 0.5rem 0 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--fs-xs);
    transition:
      border-color var(--dur-fast),
      color var(--dur-fast),
      box-shadow var(--dur-fast);
  }
  .palette-trigger:hover {
    color: var(--text);
    border-color: var(--border-strong);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .palette-trigger kbd {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border-strong);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }
  /* Sun shows in dark mode, moon in light: each offers the other theme. */
  .theme-toggle {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text-secondary);
    transition:
      color var(--dur-fast),
      border-color var(--dur-fast),
      box-shadow var(--dur-fast);
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--border-strong);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .theme-toggle svg {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }
  .theme-toggle__sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global(:root[data-theme='dark']) .theme-toggle__sun {
    opacity: 1;
    transform: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  /* Without JavaScript the toggle cannot work, so it is not shown. */
  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }
  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 55%, #fff));
    transform: scaleX(0);
    transform-origin: left;
  }
  @supports (animation-timeline: scroll()) {
    /* Sun shows in dark mode, moon in light: each offers the other theme. */
    .theme-toggle {
      display: grid;
      flex-shrink: 0;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: var(--surface);
      color: var(--text-secondary);
      transition:
        color var(--dur-fast),
        border-color var(--dur-fast),
        box-shadow var(--dur-fast);
    }
    .theme-toggle:hover {
      color: var(--accent);
      border-color: var(--border-strong);
      box-shadow: 0 0 0 3px var(--accent-dim);
    }
    .theme-toggle svg {
      grid-area: 1 / 1;
      transition:
        opacity var(--dur) var(--ease-out),
        transform var(--dur-slow) var(--ease-out);
    }
    .theme-toggle__sun {
      opacity: 0;
      transform: rotate(-90deg) scale(0.6);
    }
    :global(:root[data-theme='dark']) .theme-toggle__sun {
      opacity: 1;
      transform: none;
    }
    :global(:root[data-theme='dark']) .theme-toggle__moon {
      opacity: 0;
      transform: rotate(90deg) scale(0.6);
    }
    /* Without JavaScript the toggle cannot work, so it is not shown. */
    :global(:root:not([data-theme])) .theme-toggle {
      display: none;
    }
    .header__progress {
      animation: header-progress linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes header-progress {
    to {
      transform: scaleX(1);
    }
  }
  .navigation {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .navigation a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0.6rem 0.8rem;
    border-radius: 4px;
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    white-space: nowrap;
    transition:
      background var(--dur-fast),
      color var(--dur-fast);
  }
  .navigation a:hover,
  .navigation a[aria-current] {
    color: var(--accent);
    background: var(--accent-dim);
  }
  .navigation a[aria-current] {
    font-weight: 600;
  }
  .navigation .navigation__contact {
    margin-left: 0.65rem;
    border: 1px solid var(--border-strong);
  }
  @media (max-width: 55.99rem) {
    .header__inner {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.45rem;
    }
    .identity {
      font-size: 0.85rem;
    }
    .identity__mark {
      width: 1.8rem;
      height: 1.8rem;
      font-size: 1rem;
    }
    nav {
      width: 100%;
      overflow-x: auto;
    }
    .navigation {
      width: max-content;
      min-width: 100%;
      padding: 3px;
    }
    .navigation a {
      min-height: 40px;
      padding: 0.5rem 0.65rem;
      font-size: 0.75rem;
    }
    .navigation .navigation__contact {
      margin-left: 0;
    }
    .header__end {
      width: 100%;
    }
    /* Touch screens have no ⌘K; the palette stays keyboard-only there. */
    .palette-trigger {
      display: none;
    }
    .header__inner {
      position: relative;
    }
    .theme-toggle {
      position: absolute;
      top: 0.55rem;
      right: var(--gutter);
      width: 36px;
      height: 36px;
    }
  }
</style>
