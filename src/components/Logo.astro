---
/** Monogram mark. Inherits colour from the parent via `currentColor`. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className } = Astro.props;
---

<svg
  class:list={['logo', className]}
  viewBox="0 0 32 32"
  width={size}
  height={size}
  role="img"
  aria-label="Aman Sriven"
>
  <path
    fill="currentColor"
    fill-rule="evenodd"
    d="M14.1 6h3.8L24.6 26h-4L16 12.4 11.4 26h-4Zm-1.5 13.2h6.8v2.7h-6.8Z"></path>
</svg>

<style>
  .logo {
    display: block;
    flex-shrink: 0;
  }
</style>
