---
/**
 * PostHog's standard web snippet (posthog.com/docs/libraries/astro), with the
 * project key and host read from public Astro build variables.
 *
 * Open the site once with `?notrack` to stop counting your own visits in that
 * browser; `?track` undoes it.
 *
 * Short links in `public/_redirects` (amansriven.com/cv, /li, /gh) forward to
 * `/?ref=<source>`. The ref is tidied out of the address bar straight away and
 * attached to that visitor's events as `source`, for breakdowns in PostHog.
 */
interface Props {
  apiKey: string;
  apiHost: string;
}
const { apiKey, apiHost } = Astro.props;
---

<script is:inline define:vars={{ apiKey, apiHost }}>
  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagResult reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

  const url = new URL(window.location.href);
  const optingOut = url.searchParams.has('notrack');
  const optingIn = url.searchParams.has('track');
  // Cloudflare sends /cv/stripe/ to the `/cv/*` splat, so the ref arrives as
  // `cv-stripe/`. Drop the stray slash rather than lose the source.
  const ref = url.searchParams.get('ref')?.replace(/\/+$/, '');
  const source = ref && /^[a-z0-9-]{1,40}$/i.test(ref) ? ref.toLowerCase() : null;

  // Keep the address bar clean: amansriven.com, not amansriven.com/?ref=cv.
  ['ref', 'notrack', 'track'].forEach((key) => url.searchParams.delete(key));
  if (url.href !== window.location.href) history.replaceState(history.state, '', url);

  posthog.init(apiKey, {
    // PUBLIC_POSTHOG_HOST may be PostHog's own ingest host or the managed
    // reverse proxy on our subdomain (e.amansriven.com), which ad blockers
    // don't recognise. ui_host stays PostHog's app so its toolbar and links
    // still work behind the proxy.
    api_host: apiHost,
    ui_host: 'https://us.posthog.com',
    defaults: '2026-05-30',
    // Don't count the very visit that opts out.
    ...(optingOut && { capture_pageview: false }),
    // Runs before the first pageview, so that pageview carries the source too.
    // `register` rather than `register_for_session`: PostHog clears session
    // properties when a first-time visitor's session starts, which is exactly
    // the visit that matters. The source sticks to the browser until the next
    // short link replaces it.
    loaded: (ph) => {
      if (source) ph.register({ source });
    },
  });

  if (optingOut) posthog.opt_out_capturing();
  if (optingIn) posthog.opt_in_capturing();
</script>
