---
import { Image } from 'astro:assets';
// Pre-cropped to 4:5 around the face; the landing page keeps the studio headshot.
import portrait from '../assets/portrait/aman-lake.jpg';
import { socials } from '../lib/site';
import SectionHead from './SectionHead.astro';
import SocialIcon from './SocialIcon.astro';

const currently = [
  { label: 'Building', value: 'Roleward' },
  { label: 'Studying', value: 'CS + Math, Texas A&M ’28' },
  { label: 'Also', value: 'Software developer, Sinn Fund' },
  { label: 'Shipping', value: 'Maroon Rides, Aggie Coding Club' },
];

const toolkit = [
  {
    label: 'Languages',
    items: ['Python', 'Java', 'C++', 'C', 'TypeScript', 'JavaScript', 'SQL', 'Go', 'Rust'],
  },
  {
    label: 'Frameworks & data',
    items: [
      'FastAPI',
      'React',
      'Node.js',
      'Next.js',
      'PyTorch',
      'Spark',
      'Spring Boot',
      'MongoDB',
      'PostgreSQL',
      'Kafka',
    ],
  },
  {
    label: 'Cloud & infrastructure',
    items: [
      'AWS',
      'Azure',
      'Databricks',
      'Kubernetes',
      'Docker',
      'Redis',
      'Helm',
      'ArgoCD',
      'CI/CD',
      'Prometheus / Grafana',
    ],
  },
];
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<section
  class:list={['section', 'about', { standalone }]}
  id="about"
  aria-label={standalone ? 'About details' : undefined}
  aria-labelledby={standalone ? undefined : 'about-heading'}
>
  <div class="shell">
    {
      !standalone && (
        <SectionHead index="04" title="About" meta="Texas A&M · Class of 2028" id="about-heading" />
      )
    }

    <!-- Bio beside the portrait -->
    <div class="about__grid">
      <div class="about__prose" data-reveal>
        <p class="about__lead">
          I&rsquo;m a computer science student at Texas A&amp;M, and most of what I care about sits
          where infrastructure meets a product someone actually opens.
        </p>
        <p>
          The two halves inform each other. Working on a gateway that routes hundreds of thousands
          of model requests a day teaches you what a system does when it is tired — which is the
          part that decides whether anyone trusts it. Shipping a consumer app to real users teaches
          you that none of that matters if the first screen is confusing.
        </p>
        <p>
          Lately I&rsquo;ve been most interested in systems where a language model is one component
          among many rather than the whole answer: keeping the deterministic parts deterministic,
          making failure legible, and giving whoever is on the other end enough evidence to disagree
          with the machine.
        </p>
      </div>

      <figure class="about__portrait" data-reveal>
        <Image
          src={portrait}
          alt="Aman Sriven smiling on a lakeside deck, with boats docked behind him"
          widths={[320, 480, 720, 960]}
          sizes="(max-width: 61.99rem) 70vw, 20rem"
        />
      </figure>
    </div>

    <!-- Three equal cards: what I'm doing, who I am off-hours, where to find me -->
    <div class="about__cards" data-reveal>
      <section class="card" aria-labelledby="currently-heading">
        <h2 class="card__title" id="currently-heading">Currently</h2>
        <dl class="currently">
          {
            currently.map((item) => (
              <div class="currently__row">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="card" aria-labelledby="interests-heading">
        <h2 class="card__title" id="interests-heading">Away from the keyboard</h2>
        <p class="card__text">
          I enjoy a good true-crime mystery, the Marvel universe, and strategy and role-playing
          games.
        </p>
      </section>

      <section class="card" aria-labelledby="elsewhere-heading">
        <h2 class="card__title" id="elsewhere-heading">Elsewhere</h2>
        <ul class="about__links">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener"
                >
                  <span
                    class="social-circle social-circle--sm"
                    data-brand={social.label.toLowerCase()}
                  >
                    <SocialIcon label={social.label} />
                  </span>
                  <span class="about__link-text">
                    <span class="about__label">{social.label}</span>
                    <span class="mono about__handle">{social.handle}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- Toolkit: one card per layer, each technology as a tag -->
    <section class="toolkit" data-reveal aria-labelledby="toolkit-heading">
      <h2 id="toolkit-heading">Toolkit</h2>
      <div class="toolkit__grid">
        {
          toolkit.map((group) => (
            <div class="card">
              <h3 class="card__title">{group.label}</h3>
              <ul class="toolkit__tags">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</section>

<style>
  .standalone {
    padding-top: 0;
  }

  /* --- Bio + portrait ---------------------------------------------- */
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2.5rem, 6vw, 5rem);
    /* Photo sits level with the middle of the bio rather than hanging off its top. */
    align-items: center;
  }

  .about__prose {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
    font-size: var(--fs-sm);
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .about__lead {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--text);
    letter-spacing: var(--tracking-tight);
  }

  .about__portrait {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 24px 48px -32px rgb(44 38 37 / 45%);
  }

  .about__portrait :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* The file is already cropped around the face. */
    object-position: center;
  }

  /* --- Shared card -------------------------------------------------- */
  .card {
    padding: var(--space-5) var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .card__title {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .card__text {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.75;
  }

  /* --- Info cards --------------------------------------------------- */
  /* "Currently" holds the longest lines, so it gets a little more room. */
  .about__cards {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .currently {
    display: grid;
    gap: var(--space-3);
  }

  .currently__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
  }

  .currently__row dt {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .currently__row dd {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .about__links {
    display: grid;
    gap: var(--space-3);
  }

  .about__links a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    color: var(--text-secondary);
    transition: color var(--dur-fast);
  }

  .about__links a:hover {
    color: var(--text);
  }

  .about__link-text {
    display: grid;
    min-width: 0;
  }

  .about__label {
    font-size: var(--fs-sm);
    line-height: 1.3;
  }

  .about__handle {
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--fs-micro);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* --- Toolkit ------------------------------------------------------ */
  .toolkit {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .toolkit h2 {
    margin-bottom: var(--space-5);
    font: 400 1.6rem var(--font-display);
  }

  .toolkit__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .toolkit__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .toolkit__tags li {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    white-space: nowrap;
  }

  /* --- Responsive --------------------------------------------------- */
  @media (max-width: 61.99rem) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__portrait {
      width: 100%;
      max-width: 20rem;
      justify-self: center;
      grid-row: 1;
    }

    .about__cards,
    .toolkit__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
