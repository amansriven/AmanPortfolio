---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
// Pre-cropped to 4:5 around the face; the landing page keeps the studio headshot.
import portrait from '../assets/portrait/aman-lake.jpg';
import { socials } from '../lib/site';
import SectionHead from './SectionHead.astro';
import SocialIcon from './SocialIcon.astro';

const currently = [
  { label: 'Building', value: 'Roleward' },
  { label: 'Studying', value: 'CS + Math, Texas A&M ’28' },
  { label: 'Also', value: 'Software developer, Sinn Fund' },
  { label: 'Shipping', value: 'Delta Code' },
  { label: 'Aiming', value: 'Quantitative software engineering' },
];

const toolkit = [
  {
    label: 'Languages',
    items: ['Python', 'Java', 'C++', 'C', 'TypeScript', 'JavaScript', 'SQL', 'Go', 'Rust'],
  },
  {
    label: 'Frameworks & data',
    items: [
      'FastAPI',
      'React',
      'Node.js',
      'Next.js',
      'PyTorch',
      'Spark',
      'Spring Boot',
      'MongoDB',
      'PostgreSQL',
      'Kafka',
    ],
  },
  {
    label: 'Cloud & infrastructure',
    items: [
      'AWS',
      'Azure',
      'Databricks',
      'Kubernetes',
      'Docker',
      'Redis',
      'Helm',
      'ArgoCD',
      'CI/CD',
      'Prometheus / Grafana',
    ],
  },
];
/* Hovering a toolkit tag lists the projects whose stack includes it, so every
   claim points at real work. Names match loosely (Next.js = NextJS); AWS also
   covers the individual AWS services a project lists. */
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const key = (name: string) => name.toLowerCase().replace(/[^a-z0-9+#]/g, '');
const aliases: Record<string, string[]> = {
  aws: ['awslambda', 's3', 'dynamodb', 'cognito'],
};
function usedIn(tool: string): string[] {
  const keys = [key(tool), ...(aliases[key(tool)] ?? [])];
  return projects
    .filter((project) => project.data.stack.some((tech) => keys.includes(key(tech))))
    .map((project) => project.data.title);
}

interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<section
  class:list={['section', 'about', { standalone }]}
  id="about"
  aria-label={standalone ? 'About details' : undefined}
  aria-labelledby={standalone ? undefined : 'about-heading'}
>
  <div class="shell">
    {
      !standalone && (
        <SectionHead index="04" title="About" meta="Texas A&M · Class of 2028" id="about-heading" />
      )
    }

    <!-- Bio beside the portrait -->
    <div class="about__grid">
      <div class="about__prose" data-reveal>
        <!-- Written by Aman; lightly trimmed for the web. -->
        <p class="about__lead">
          I&rsquo;m passionate about developing technology that makes activities and resources
          accessible, organized, and efficient.
        </p>
        <p>
          My favorite part about coding is breathing life into my wildest ideas and turning them
          into useful products. The most fulfilling part is seeing those products help people make
          better decisions, access nurturing resources, or solve daunting problems.
        </p>
        <p>
          Working across full-stack development, AI, cloud infrastructure, and engineering teams has
          shown me that reliable, scalable solutions require technical skill. However, you may be
          surprised to learn that communication, work ethic, and ambition play the biggest role.
        </p>
        <p>
          My biggest interest lies in programs that take in substantial amounts of data accurately
          and make predictions better than a professional. That&rsquo;s why I aspire to excel in
          quantitative software engineering, where programming, data analysis, performance, and
          decision-making meet. I want to become an engineer who builds reliable, data-backed
          systems that make those predictions efficiently and accurately.
        </p>
      </div>

      <figure class="about__portrait" data-reveal>
        <Image
          src={portrait}
          alt="Aman Sriven smiling on a lakeside deck, with boats docked behind him"
          widths={[320, 480, 720, 960]}
          sizes="(max-width: 61.99rem) 70vw, 20rem"
        />
      </figure>
    </div>

    <!-- Three equal cards: what I'm doing, who I am off-hours, where to find me -->
    <div class="about__cards" data-reveal>
      <section class="card spotlight" aria-labelledby="currently-heading">
        <h2 class="card__title" id="currently-heading">Currently</h2>
        <dl class="currently">
          {
            currently.map((item) => (
              <div class="currently__row">
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="card spotlight" aria-labelledby="interests-heading">
        <h2 class="card__title" id="interests-heading">Away from the keyboard</h2>
        <p class="card__text">
          I enjoy a good true-crime mystery, the Marvel universe, and strategy and role-playing
          games.
        </p>
      </section>

      <section class="card spotlight" aria-labelledby="elsewhere-heading">
        <h2 class="card__title" id="elsewhere-heading">Elsewhere</h2>
        <ul class="about__links">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener"
                >
                  <span
                    class="social-circle social-circle--sm"
                    data-brand={social.label.toLowerCase()}
                  >
                    <SocialIcon label={social.label} />
                  </span>
                  <span class="about__link-text">
                    <span class="about__label">{social.label}</span>
                    <span class="mono about__handle">{social.handle}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <!-- Toolkit: one card per layer, each technology as a tag -->
    <section class="toolkit" data-reveal aria-labelledby="toolkit-heading">
      <h2 id="toolkit-heading">Toolkit</h2>
      <div class="toolkit__grid">
        {
          toolkit.map((group) => (
            <div class="card spotlight">
              <h3 class="card__title">{group.label}</h3>
              <ul class="toolkit__tags">
                {group.items.map((item) => {
                  const used = usedIn(item);
                  return used.length > 0 ? (
                    <li class="toolkit__tag--used">
                      {item}
                      <span class="toolkit__tip">
                        <span class="visually-hidden">: </span>Used in {used.join(', ')}
                      </span>
                    </li>
                  ) : (
                    <li>{item}</li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</section>

<style>
  .standalone {
    padding-top: 0;
  }

  /* --- Bio + portrait ---------------------------------------------- */
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: clamp(2.5rem, 6vw, 5rem);
    /* Photo sits level with the middle of the bio rather than hanging off its top. */
    align-items: center;
  }

  .about__prose {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
    font-size: var(--fs-sm);
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .about__lead {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--text);
    letter-spacing: var(--tracking-tight);
  }

  .about__portrait {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: 0 24px 48px -32px rgb(var(--shadow-rgb) / 45%);
  }

  .about__portrait :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* The file is already cropped around the face. */
    object-position: center;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .about__portrait:hover :global(img) {
    transform: scale(1.04);
  }

  /* --- Shared card -------------------------------------------------- */
  .card {
    padding: var(--space-5) var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease-out);
  }

  /* No lift: these cards aren't links, so they only light up. */
  .card:hover {
    border-color: var(--border-strong);
  }

  .card__title {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .card__text {
    color: var(--text-secondary);
    font-size: var(--fs-sm);
    line-height: 1.75;
  }

  /* --- Info cards --------------------------------------------------- */
  /* "Currently" holds the longest lines, so it gets a little more room. */
  .about__cards {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .currently {
    display: grid;
    gap: var(--space-3);
  }

  .currently__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
  }

  .currently__row dt {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .currently__row dd {
    margin: 0;
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .about__links {
    display: grid;
    gap: var(--space-3);
  }

  .about__links a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    color: var(--text-secondary);
    transition: color var(--dur-fast);
  }

  .about__links a:hover {
    color: var(--text);
  }

  .about__link-text {
    display: grid;
    min-width: 0;
  }

  .about__label {
    font-size: var(--fs-sm);
    line-height: 1.3;
  }

  .about__handle {
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--fs-micro);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* --- Toolkit ------------------------------------------------------ */
  .toolkit {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .toolkit h2 {
    margin-bottom: var(--space-5);
    font: 400 1.6rem var(--font-display);
  }

  .toolkit__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .toolkit__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .toolkit__tags li {
    position: relative;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  /* A dot marks the tools that appear in a project on this site. */
  .toolkit__tag--used::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
  }

  /* Visually a tooltip; for screen readers it is read inline after the name. */
  .toolkit__tip {
    position: absolute;
    bottom: calc(100% + 0.45rem);
    left: 50%;
    z-index: 2;
    /* Long lists (TypeScript is in every project) wrap instead of running
       past the card. */
    width: max-content;
    max-width: 14rem;
    padding: 0.35rem 0.6rem;
    white-space: normal;
    line-height: 1.4;
    border-radius: 4px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--font-sans);
    font-size: var(--fs-micro);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .toolkit__tags li:hover {
      border-color: var(--border-strong);
      color: var(--text);
      transform: translateY(-1px);
    }

    .toolkit__tag--used:hover {
      border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
      color: var(--accent);
    }

    .toolkit__tag--used:hover .toolkit__tip {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  /* Touch screens have no hover, so the tip would never show; keep it out of
     the layout entirely. Screen readers still get the text. */
  @media (hover: none) {
    .toolkit__tip {
      clip-path: inset(50%);
      width: 1px;
      height: 1px;
      overflow: hidden;
    }
  }

  /* --- Responsive --------------------------------------------------- */
  @media (max-width: 61.99rem) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__portrait {
      width: 100%;
      max-width: 20rem;
      justify-self: center;
      grid-row: 1;
    }

    .about__cards,
    .toolkit__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
