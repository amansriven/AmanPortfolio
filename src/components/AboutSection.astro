---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait/aman.jpg';
import { socials } from '../lib/site';
import SectionHead from './SectionHead.astro';
import SocialIcon from './SocialIcon.astro';

const currently = [
  { label: 'Building', value: 'Roleward' },
  { label: 'Studying', value: 'CS + Math, Texas A&M ’28' },
  { label: 'Also', value: 'Software developer, Sinn Fund' },
  { label: 'Shipping', value: 'Maroon Rides, Aggie Coding Club' },
];

const toolkit = [
  {
    label: 'Languages',
    items: ['Python', 'Java', 'C++', 'C', 'TypeScript', 'JavaScript', 'SQL', 'Go', 'Rust'],
  },
  {
    label: 'Frameworks & data',
    items: [
      'FastAPI',
      'React',
      'Node.js',
      'Next.js',
      'PyTorch',
      'Spark',
      'Spring Boot',
      'MongoDB',
      'PostgreSQL',
      'Kafka',
    ],
  },
  {
    label: 'Cloud & infrastructure',
    items: [
      'AWS',
      'Azure',
      'Databricks',
      'Kubernetes',
      'Docker',
      'Redis',
      'Helm',
      'ArgoCD',
      'CI/CD',
      'Prometheus / Grafana',
    ],
  },
];
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<section
  class:list={['section', 'about', { standalone }]}
  id="about"
  aria-label={standalone ? 'About details' : undefined}
  aria-labelledby={standalone ? undefined : 'about-heading'}
>
  <div class="shell">
    {
      !standalone && (
        <SectionHead index="04" title="About" meta="Texas A&M · Class of 2028" id="about-heading" />
      )
    }

    <div class="about__grid">
      <div class="about__prose" data-reveal>
        <p class="about__lead">
          I&rsquo;m a computer science student at Texas A&amp;M, and most of what I care about sits
          where infrastructure meets a product someone actually opens.
        </p>
        <p>
          The two halves inform each other. Working on a gateway that routes hundreds of thousands
          of model requests a day teaches you what a system does when it is tired — which is the
          part that decides whether anyone trusts it. Shipping a consumer app to real users teaches
          you that none of that matters if the first screen is confusing.
        </p>
        <p>
          Lately I&rsquo;ve been most interested in systems where a language model is one component
          among many rather than the whole answer: keeping the deterministic parts deterministic,
          making failure legible, and giving whoever is on the other end enough evidence to disagree
          with the machine.
        </p>

        <section class="interests" aria-labelledby="interests-heading">
          <h2 id="interests-heading">Away from the keyboard</h2><p>
            I enjoy a good true-crime mystery, the Marvel universe, and strategy and role-playing
            games.
          </p>
        </section>
      </div>

      <aside class="about__side" data-reveal>
        <figure class="about__portrait">
          <Image
            src={portrait}
            alt="Aman Sriven"
            widths={[320, 480, 720]}
            sizes="(max-width: 62rem) 60vw, 22rem"
          />
        </figure>

        <div class="currently-block">
          <p class="eyebrow currently__title">Currently</p>
          <dl class="currently">
            {
              currently.map((item) => (
                <div class="currently__row">
                  <dt class="mono">{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <ul class="about__links">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener"
                >
                  <span
                    class="social-circle social-circle--sm"
                    data-brand={social.label.toLowerCase()}
                  >
                    <SocialIcon label={social.label} />
                  </span>
                  <span class="about__label">{social.label}</span>
                  <span class="mono about__handle">{social.handle}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    <section class="toolkit" data-reveal aria-labelledby="toolkit-heading">
      <h2 id="toolkit-heading">Toolkit</h2>
      {
        toolkit.map((group) => (
          <div class="toolkit__group">
            <p class="eyebrow">{group.label}</p>
            <p class="toolkit__items mono">{group.items.join('  ·  ')}</p>
          </div>
        ))
      }
    </section>
  </div>
</section>

<style>
  .standalone {
    padding-top: 0;
  }
  .interests {
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .interests h2,
  .toolkit h2 {
    font: 400 1.6rem var(--font-display);
  }
  .interests p {
    margin-top: 0.7rem;
    color: var(--text-secondary);
    font-size: var(--fs-sm);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-9);
    align-items: start;
  }

  .about__prose {
    display: grid;
    gap: var(--space-5);
    max-width: 42rem;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  .about__lead {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--text);
    letter-spacing: var(--tracking-tight);
    text-wrap: pretty;
  }

  /* --- Side rail ------------------------------------------------ */
  .about__side {
    display: grid;
    gap: var(--space-7);
  }

  .about__portrait {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .about__portrait :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 22%;
    filter: none;
    transition: filter var(--dur-slow) var(--ease-out);
  }

  .about__portrait:hover :global(img) {
    filter: saturate(1) contrast(1) brightness(1);
  }

  .currently {
    display: grid;
    gap: var(--space-3);
  }

  .currently__title {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .currently__row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
  }

  .currently__row dt {
    color: var(--text-faint);
    font-size: var(--fs-micro);
  }

  .currently__row dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }

  .about__links {
    display: grid;
  }

  .about__links a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    transition: color var(--dur) var(--ease-out);
  }

  .about__links li:last-child a {
    border-bottom: 1px solid var(--border);
  }

  .about__links a:hover {
    color: var(--text);
  }

  .about__label {
    flex: 1;
  }

  .about__handle {
    color: var(--text-faint);
    font-size: var(--fs-micro);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* --- Toolkit -------------------------------------------------- */
  .toolkit {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .toolkit__group {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
  }

  .toolkit__items {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.9;
    text-wrap: pretty;
  }

  @media (max-width: 61.99rem) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .about__portrait {
      max-width: 20rem;
    }

    .toolkit__group {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
