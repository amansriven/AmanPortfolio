---
interface Props {
  /** Short label rendered above the body, e.g. "Decision", "Tradeoff". */
  label?: string;
  title?: string;
}
const { label = 'Decision', title } = Astro.props;
---

<aside class="callout">
  <p class="eyebrow callout__label">{label}</p>
  {title && <p class="callout__title">{title}</p>}
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  /* A quiet card with a slim accent bar: stands out from the prose without
     competing with it. */
  .callout {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .callout::before {
    content: '';
    position: absolute;
    top: var(--space-5);
    bottom: var(--space-5);
    left: -1px;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--accent);
  }

  .callout__label {
    color: var(--accent);
  }

  .callout__title {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
    letter-spacing: var(--tracking-tight);
    text-wrap: pretty;
  }

  .callout__body {
    margin-top: var(--space-1);
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .callout__body :global(p + p) {
    margin-top: var(--space-3);
  }

  @media (max-width: 47.99rem) {
    .callout {
      padding: var(--space-4) var(--space-5);
    }
  }
</style>
